#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Best-effort update check — output to stderr so it doesn't contaminate JSON response
# If check-update.sh is unavailable or fails, continue silently
bash "${PLUGIN_ROOT}/scripts/check-update.sh" >&2 2>/dev/null || true

using_hotl_content=$(cat "${PLUGIN_ROOT}/skills/using-hotl/SKILL.md" 2>&1 || echo "Error reading using-hotl skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_hotl_escaped=$(escape_for_json "$using_hotl_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have HOTL superpowers.\n\n**Below is the full content of your 'hotl:using-hotl' skill - your introduction to using HOTL skills. For all other skills, use the 'Skill' tool:**\n\n${using_hotl_escaped}\n</EXTREMELY_IMPORTANT>"

cat <<EOF
{
  "additional_context": "${session_context}",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${session_context}"
  }
}
EOF

exit 0
