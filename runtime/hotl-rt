  \"revision\": 0,
  \"started_at\": \"${started_at}\",
  \"last_update\": \"${started_at}\",
  \"completed_at\": null,
  \"status\": \"running\",
  \"current_step\": 1,
  \"total_steps\": ${total_steps},
  \"report_path\": ${report_path_json},
  \"finish\": {
    \"disposition\": null,
    \"recorded_at\": null,
    \"target_branch\": null,
    \"remote\": null,
    \"pr_url\": null,
    \"branch_action\": null,
    \"worktree_action\": null,
    \"artifacts_preserved_at\": null,
    \"notes\": null
  },
  \"steps\": ${steps_json}
}"

    local state_file="${STATE_DIR}/${run_id}.json"
    echo "$state_json" > "$state_file"

    # Build report
    local report_file="${REPORT_DIR}/${run_id}.md"
    {
        echo "# Execution Report: ${run_id}"
        echo ""
        echo "**Workflow:** $(basename "$workflow")"
        echo "**Source Workflow:** ${source_workflow_path}"
        if [ -n "$source_branch" ]; then
            echo "**Source Branch:** ${source_branch}"
        fi
        if [ -n "$source_head" ]; then
            echo "**Source HEAD:** ${source_head}"
        fi
        echo "**Intent:** ${fm_intent}"
        echo "**Branch:** ${fm_branch}"
        echo "**Executor:** ${executor_mode}"
        echo "**Execution Root:** ${execution_root}"
        if [ -n "$worktree_path" ]; then
            echo "**Worktree:** ${worktree_path}"
        fi
        echo "**Started:** ${started_at}"
        echo "**Updated:** ${started_at}"
        echo "**Status:** running"
        echo ""
        echo "| Step | Name | Status | Iterations |"
        echo "|------|------|--------|------------|"
        for i in "${!step_numbers[@]}"; do
            printf "| %2s   | %s | · Pending | - |\n" "${step_numbers[$i]}" "${step_names[$i]}"
        done
        echo ""
        echo "## Event Log"
        echo ""
    } > "$report_file"

    # Print run_id to stdout
    echo "$run_id"
}

# Parse a step block and append to arrays
_parse_step_block() {
    local num="$1"
    local name="$2"
    local block="$3"

    local action="" loop_val="false" max_iter="3" gate_val="null"
    local verify_json
    verify_json=$(verify_object_shell "")

    action=$(echo "$block" | { grep -i '^action:' || true; } | sed 's/^[Aa]ction:[[:space:]]*//' | head -1)
    loop_val=$(echo "$block" | { grep -i '^loop:' || true; } | sed 's/^[Ll]oop:[[:space:]]*//' | head -1)
    [ -z "$loop_val" ] && loop_val="false"

    local mi
    mi=$(echo "$block" | { grep -i '^max_iterations:' || true; } | sed 's/^[Mm]ax_iterations:[[:space:]]*//' | head -1)
    [ -n "$mi" ] && max_iter="$mi"

    # Parse verify (scalar form only for v1 shell support)
    local verify_line
    verify_line=$(echo "$block" | { grep -i '^verify:' || true; } | head -1)
    if [ -n "$verify_line" ]; then
        local vval
        vval="${verify_line#*:}"
        vval="${vval#"${vval%%[![:space:]]*}"}"
        if [ -n "$vval" ]; then
            # Scalar form — type: shell
            verify_json=$(verify_object_shell "$vval")
        else
            local struct_block=""
            local in_verify=0
            while IFS= read -r vline; do
                if [ "$in_verify" -eq 0 ] && echo "$vline" | grep -qi '^verify:$'; then
                    in_verify=1
                    continue
                fi
                if [ "$in_verify" -eq 1 ]; then
                    if echo "$vline" | grep -Eq '^[[:space:]]'; then
                        struct_block="${struct_block}${vline}
"
                    elif [ -z "$vline" ]; then
                        continue
                    else
                        break
                    fi
                fi
            done <<< "$block"

            if [ -n "$struct_block" ]; then
                verify_json=$(parse_verify_block_json "$struct_block")
            fi
        fi
    fi

    local gv
    gv=$(echo "$block" | { grep -i '^gate:' || true; } | sed 's/^[Gg]ate:[[:space:]]*//' | head -1)
    [ -n "$gv" ] && gate_val="$gv"

    step_numbers+=("$num")
    step_names+=("$name")
    step_actions+=("$action")
    step_loops+=("$loop_val")
    step_max_iters+=("$max_iter")
    step_verify_jsons+=("$verify_json")
    step_gates+=("$gate_val")
}

cmd_step() {
    if [ $# -lt 2 ]; then
        echo "usage: hotl-rt step <step-number> <start|verify|retry|block> [--run-id <run-id>]" >&2
        exit 1
    fi

    require_jq

    local step_num="$1"
    local action="$2"
    shift 2
    local run_id="${HOTL_RUN_ID:-}"
    local block_reason=""

    case "$action" in
        start|verify|retry)
            if [ $# -gt 0 ]; then
                if [ "$1" = "--run-id" ] && [ $# -eq 2 ]; then
                    run_id="$2"
                    shift 2
                else
                    echo "ERROR: Unknown option for step $action: $1" >&2
                    exit 1
                fi
            fi
            ;;
        block)
            while [ $# -gt 0 ]; do
                case "$1" in
                    --reason) block_reason="$2"; shift 2 ;;
                    --run-id) run_id="$2"; shift 2 ;;
                    *) echo "ERROR: Unknown option for block: $1" >&2; exit 1 ;;
                esac
            done

            if [ -z "$block_reason" ]; then
                echo "ERROR: --reason is required for block" >&2
                exit 1
            fi
            ;;
    esac

    local state_file
    state_file=$(find_active_state "$run_id")
    local resolved_run_id
    resolved_run_id=$(jq -r '.run_id' "$state_file")
    acquire_run_lock "$resolved_run_id"
    enforce_controller_ownership "$state_file"
    enforce_execution_evidence_mutable "$state_file" "step $action"
    if [[ ! "$step_num" =~ ^[1-9][0-9]*$ ]] || [ "$step_num" -gt "$(jq '.steps | length' "$state_file")" ]; then
        echo "ERROR: Invalid step number: $step_num" >&2
        exit 1
    fi
    local report
    report=$(report_path_from_state "$state_file")
    ensure_report_from_state "$state_file" "$report"
    local ts
    ts=$(now_iso)
    local time_short
    time_short=$(now_time)

    if [ "$action" != block ]; then
        local run_status
        run_status=$(jq -r '.status' "$state_file")
        if [ "$run_status" != running ]; then
            echo "ERROR: Run is '$run_status'; resolve gates, policy pauses, or budgets before step $action" >&2
            exit 1
        fi
    fi

    case "$action" in
        start)
            # Validate step exists and is pending or failed (for retry-then-start)
            local current_status
            current_status=$(jq -r ".steps[$((step_num - 1))].status" "$state_file")
            if [ "$current_status" != "pending" ] && [ "$current_status" != "in_progress" ]; then
                echo "ERROR: Step $step_num is '$current_status', expected 'pending'" >&2
                exit 1
            fi

            if [ "$step_num" -gt 1 ]; then
                local prior_incomplete
                prior_incomplete=$(jq --argjson index "$((step_num - 1))" '[.steps[0:$index][] | select(.status != "done")] | first | .number // empty' "$state_file")
                if [ -n "$prior_incomplete" ]; then
                    echo "ERROR: Step $prior_incomplete must be done before step $step_num can start" >&2
                    exit 1
                fi
            fi

            local attempts max_iter
            attempts=$(jq -r ".steps[$((step_num - 1))].attempts" "$state_file")
            max_iter=$(jq -r ".steps[$((step_num - 1))].max_iterations // 1" "$state_file")
            if [ "$attempts" -ge "$max_iter" ]; then
                echo "ERROR: Step $step_num reached maximum iterations ($max_iter)" >&2
                exit 1
            fi

            if ! enforce_transition_budgets "$state_file" "$report" 1; then
                exit 1
            fi
            ts=$(now_iso)
            time_short=$(now_time)

            local step_name
            step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")

            # Update state JSON
            local updated
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" '
                .status = (if ([.policy_pauses[]?] | length) == 0 and ([.budgets.exceeded[]?] | length) == 0 then "running" else "paused" end) |
                .current_step = $num |
                .last_update = $ts |
                .steps[$num - 1].status = "in_progress" |
                .steps[$num - 1].started_at = $ts |
                .steps[$num - 1].attempts += 1
            ' "$state_file")
            state_write "$state_file" "$updated"

            # Update report
            local attempts
            attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
            report_update_step_row "$report" "$step_num" "→ Running" "$attempts"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$time_short]** → Step $step_num: $step_name"

            echo "started step $step_num"
            ;;

        verify)
            local verify_type verify_cmd step_name verify_json
            if [ "$(jq -r ".steps[$((step_num - 1))].status" "$state_file")" != "in_progress" ]; then
                echo "ERROR: Step $step_num must be in_progress before verify" >&2
                exit 1
            fi
            if ! enforce_transition_budgets "$state_file" "$report" 0; then
                exit 1
            fi
            ts=$(now_iso)
            time_short=$(now_time)
            verify_type=$(jq -r ".steps[$((step_num - 1))].verify.type" "$state_file")
            verify_cmd=$(jq -r ".steps[$((step_num - 1))].verify.command" "$state_file")
            verify_json=$(jq -c ".steps[$((step_num - 1))].verify" "$state_file")
            step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")

            # No verify configuration — auto-pass
            if [ -z "$verify_json" ] || [ "$verify_json" = "null" ]; then
                # Block with unsupported type
                local updated
                updated=$(jq --arg ts "$ts" --argjson num "$step_num" '
                    .last_update = $ts |
                    .steps[$num - 1].status = "done" |
                    .steps[$num - 1].completed_at = $ts |
                    .steps[$num - 1].verify.passed = true
                ' "$state_file")
                state_write "$state_file" "$updated"

                local attempts
                attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
                report_update_step_row "$report" "$step_num" "✓ Done" "$attempts"
                report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
                report_append_event "$report" "**[$time_short]** ✓ Step $step_num: Done (no verify, $attempts attempt(s))"

                echo "pass (no verify command)"
                exit 0
            fi

            if [ -z "$verify_cmd" ] || [ "$verify_cmd" = "null" ]; then
                if [ "$verify_type" = "shell" ]; then
                    # No verify command — auto-pass
                    local updated
                    updated=$(jq --arg ts "$ts" --argjson num "$step_num" '
                        .last_update = $ts |
                        .steps[$num - 1].status = "done" |
                        .steps[$num - 1].completed_at = $ts |
                        .steps[$num - 1].verify.passed = true
                    ' "$state_file")
                    state_write "$state_file" "$updated"

                    local attempts
                    attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
                    report_update_step_row "$report" "$step_num" "✓ Done" "$attempts"
                    report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
                    report_append_event "$report" "**[$time_short]** ✓ Step $step_num: Done (no verify, $attempts attempt(s))"

                    echo "pass (no verify command)"
                    exit 0
                fi
            fi

            VERIFY_COMBINED_STDOUT=""
            VERIFY_COMBINED_STDERR=""
            set +e
            run_verify_checks "$verify_json"
            local exit_code=$?
            set -e

            if [ "$exit_code" -eq 200 ]; then
                local run_status
                run_status="blocked"
                if printf '%s' "$VERIFY_BLOCK_REASON" | grep -q '^human review required'; then
                    run_status="paused"
                fi

                local updated
                updated=$(jq --arg ts "$ts" --arg reason "$VERIFY_BLOCK_REASON" --arg status "$run_status" --argjson num "$step_num" '
                    .status = $status |
                    .last_update = $ts |
                    .steps[$num - 1].status = "blocked" |
                    .steps[$num - 1].block_reason = $reason
                ' "$state_file")
                state_write "$state_file" "$updated"

                report_update_step_row "$report" "$step_num" "✗ Blocked" "-"
                report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $run_status"
                report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
                report_append_event "$report" "**[$time_short]** ✗ Step $step_num: Blocked ($VERIFY_BLOCK_REASON)"

                echo "blocked: $VERIFY_BLOCK_REASON"
                exit 1
            fi

            local stdout_content stderr_content
            stdout_content="${VERIFY_STDOUT:-}"
            stderr_content="${VERIFY_STDERR:-}"

            # Escape for JSON
            local stdout_esc stderr_esc
            stdout_esc=$(echo "$stdout_content" | jq -Rs '.')
            stderr_esc=$(echo "$stderr_content" | jq -Rs '.')

            if [ "$exit_code" -eq 0 ]; then
                # PASS — transition to done
                local updated
                updated=$(jq --arg ts "$ts" --argjson num "$step_num" \
                    --argjson stdout "$stdout_esc" --argjson stderr "$stderr_esc" '
                    .last_update = $ts |
                    .steps[$num - 1].status = "done" |
                    .steps[$num - 1].completed_at = $ts |
                    .steps[$num - 1].verify.passed = true |
                    .steps[$num - 1].verify.stdout = $stdout |
                    .steps[$num - 1].verify.stderr = $stderr
                ' "$state_file")
                state_write "$state_file" "$updated"

                local attempts
                attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
                report_update_step_row "$report" "$step_num" "✓ Done" "$attempts"
                report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
                report_append_event "$report" "**[$time_short]** ✓ Step $step_num: Done ($attempts attempt(s))"

                echo "pass"
                exit 0
            fi

            # FAIL — transition to failed
            local updated
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" \
                --argjson stdout "$stdout_esc" --argjson stderr "$stderr_esc" '
                .last_update = $ts |
                .steps[$num - 1].status = "failed" |
                .steps[$num - 1].verify.passed = false |
                .steps[$num - 1].verify.stdout = $stdout |
                .steps[$num - 1].verify.stderr = $stderr
            ' "$state_file")
            state_write "$state_file" "$updated"

            local attempts
            attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
            report_update_step_row "$report" "$step_num" "✗ Failed" "$attempts"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$time_short]** ✗ Step $step_num: Failed ($attempts attempt(s))"
            if [ -n "$stderr_content" ]; then
                report_append_event "$report" "  verify stderr: $stderr_content"
            fi
            if [ -n "$stdout_content" ]; then
                report_append_event "$report" "  verify stdout: $stdout_content"
            fi

            echo "fail"
            exit 1
            ;;

        retry)
            local current_status
            current_status=$(jq -r ".steps[$((step_num - 1))].status" "$state_file")
            if [ "$current_status" != "failed" ]; then
                echo "ERROR: Step $step_num is '$current_status', expected 'failed' for retry" >&2
                exit 1
            fi

            local step_name attempts
            step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")
            attempts=$(jq -r ".steps[$((step_num - 1))].attempts" "$state_file")
            local max_iter
            max_iter=$(jq -r ".steps[$((step_num - 1))].max_iterations" "$state_file")
            if [ "$attempts" -ge "$max_iter" ]; then
                echo "ERROR: Step $step_num reached maximum iterations ($max_iter)" >&2
                exit 1
            fi

            local updated
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" '
                .last_update = $ts |
                .steps[$num - 1].status = "in_progress" |
                .steps[$num - 1].verify.passed = null |
                .steps[$num - 1].verify.stdout = null |
                .steps[$num - 1].verify.stderr = null
            ' "$state_file")
            state_write "$state_file" "$updated"

            local new_attempt=$((attempts + 1))
            report_update_step_row "$report" "$step_num" "↻ Retrying" "$new_attempt"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$time_short]** ↻ Step $step_num: Retrying ($new_attempt/$max_iter)"

            echo "retrying step $step_num (attempt $new_attempt/$max_iter)"
            ;;

        block)
            local step_name
            step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")

            local updated
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" --arg reason "$block_reason" '
                .status = "blocked" |
                .last_update = $ts |
                .steps[$num - 1].status = "blocked" |
                .steps[$num - 1].block_reason = $reason
            ' "$state_file")
            state_write "$state_file" "$updated"

            report_update_step_row "$report" "$step_num" "✗ Blocked" "-"
            report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** blocked"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$time_short]** ✗ Step $step_num: Blocked — $block_reason"

            echo "blocked step $step_num: $block_reason"
            ;;

        *)
            echo "ERROR: Unknown step action: $action" >&2
            echo "usage: hotl-rt step <step-number> <start|verify|retry|block> [--run-id <run-id>]" >&2
            exit 1
            ;;
    esac
}

cmd_gate() {
    if [ $# -lt 2 ]; then
        echo "usage: hotl-rt gate <step-number> <approved|rejected> [--mode auto|human] [--run-id <run-id>]" >&2
        exit 1
    fi

    require_jq

    local step_num="$1"
    local decision="$2"
    shift 2
    local gate_mode="human"
    local run_id="${HOTL_RUN_ID:-}"

    while [ $# -gt 0 ]; do
        case "$1" in
            --mode)
                gate_mode="$2"
                shift 2
                ;;
            --run-id)
                run_id="$2"
                shift 2
                ;;
            *)
                echo "ERROR: Unknown option for gate: $1" >&2
                exit 1
                ;;
        esac
    done

    if [ "$decision" != "approved" ] && [ "$decision" != "rejected" ]; then
        echo "ERROR: Gate decision must be 'approved' or 'rejected', got: $decision" >&2
        exit 1
    fi

    if [ "$gate_mode" != "auto" ] && [ "$gate_mode" != "human" ]; then
        echo "ERROR: Gate mode must be 'auto' or 'human', got: $gate_mode" >&2
        exit 1
    fi

    local state_file
    state_file=$(find_active_state "$run_id")
    acquire_run_lock "$(jq -r '.run_id' "$state_file")"
    enforce_controller_ownership "$state_file"
    enforce_execution_evidence_mutable "$state_file" gate
    if [[ ! "$step_num" =~ ^[1-9][0-9]*$ ]] || [ "$step_num" -gt "$(jq '.steps | length' "$state_file")" ]; then
        echo "ERROR: Invalid step number: $step_num" >&2
        exit 1
    fi
    if [ "$(jq -r '.risk_level' "$state_file")" = high ] && [ "$gate_mode" != human ]; then
        echo "ERROR: High-risk workflows require human gate decisions" >&2
        exit 1
    fi
    local report
    report=$(report_path_from_state "$state_file")
    ensure_report_from_state "$state_file" "$report"
    local ts
    ts=$(now_iso)
    local time_short
    time_short=$(now_time)

    local step_name
    step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")
    local current_status
    current_status=$(jq -r ".steps[$((step_num - 1))].status" "$state_file")
    local block_reason
    block_reason=$(jq -r ".steps[$((step_num - 1))].block_reason // \"\"" "$state_file")

    if [ "$current_status" = "blocked" ] && printf '%s' "$block_reason" | grep -q '^human review required'; then
        local updated review_note status_text

        if [ "$decision" = "approved" ]; then
            review_note="human review approved"
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" --arg decision "$decision" --arg gate_mode "$gate_mode" --arg note "$review_note" '
                .last_update = $ts |
                .steps[$num - 1].status = "done" |
                .steps[$num - 1].completed_at = $ts |
                .steps[$num - 1].block_reason = null |
                .steps[$num - 1].gate_result = $decision |
                .steps[$num - 1].gate_mode = $gate_mode |
                .steps[$num - 1].verify.passed = true |
                .steps[$num - 1].verify.stdout = $note |
                .steps[$num - 1].verify.stderr = null |
                .status = (if ([.policy_pauses[]?] | length) == 0 and ([.budgets.exceeded[]?] | length) == 0 then "running" else "paused" end)
            ' "$state_file")
            status_text="✓ Approved"
        else
            review_note="human review rejected"
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" --arg decision "$decision" --arg gate_mode "$gate_mode" --arg reason "$review_note" '
                .status = "blocked" |
                .last_update = $ts |
                .steps[$num - 1].status = "blocked" |
                .steps[$num - 1].block_reason = $reason |
                .steps[$num - 1].gate_result = $decision |
                .steps[$num - 1].gate_mode = $gate_mode |
                .steps[$num - 1].verify.passed = false |
                .steps[$num - 1].verify.stdout = null |
                .steps[$num - 1].verify.stderr = $reason
            ' "$state_file")
            status_text="✗ Rejected"
        fi

        state_write "$state_file" "$updated"
        report_update_step_row "$report" "$step_num" "$status_text" "-"
        if [ "$decision" = "approved" ]; then
            report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $(jq -r '.status' "$state_file")"
        else
            report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** blocked"
        fi
        report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
        report_append_event "$report" "**[$time_short]** Human review for Step $step_num: $decision (${gate_mode})"

        echo "human-review $step_num: $decision (${gate_mode})"
        return
    fi

    if [ "$current_status" != "done" ]; then
        echo "ERROR: Step $step_num must be done before its gate can be recorded (current status: $current_status)" >&2
        exit 1
    fi

    local updated
    updated=$(jq --arg ts "$ts" --argjson num "$step_num" --arg decision "$decision" --arg gate_mode "$gate_mode" '
        .status = (if .status == "paused" and $decision == "approved"
                    and ([.policy_pauses[]?] | length) == 0
                    and ([.budgets.exceeded[]?] | length) == 0
                    and ([.steps[] | select(.status == "blocked")] | length) == 0
                   then "running" elif $decision == "rejected" then "blocked" else .status end) |
        .last_update = $ts |
        .steps[$num - 1].gate_result = $decision |
        .steps[$num - 1].gate_mode = $gate_mode
    ' "$state_file")
    state_write "$state_file" "$updated"

    local status_text
    if [ "$decision" = "approved" ]; then
        if [ "$gate_mode" = "auto" ]; then
            status_text="⚡ Auto-approved"
        else
            status_text="✓ Approved"
        fi
    else
        status_text="✗ Rejected"
    fi

    report_update_step_row "$report" "$step_num" "$status_text" "-"
    if [ "$decision" = "approved" ]; then
        report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $(jq -r '.status' "$state_file")"
    else
        report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** blocked"
    fi
    report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
    report_append_event "$report" "**[$time_short]** Gate Step $step_num: $decision (${gate_mode})"

    echo "gate $step_num: $decision (${gate_mode})"
}

cmd_finalize() {
    require_jq
    local run_id="${HOTL_RUN_ID:-}"

    while [ $# -gt 0 ]; do
        case "$1" in
            --json)
                shift
                ;;
            --run-id)
                run_id="$2"
                shift 2
                ;;
            *)
                echo "ERROR: Unknown option for finalize: $1" >&2
                exit 1
                ;;
        esac
    done

    local state_file
    state_file=$(find_active_state "$run_id")
    acquire_run_lock "$(jq -r '.run_id' "$state_file")"
    enforce_controller_ownership "$state_file"
    local report
    report=$(report_path_from_state "$state_file")
    ensure_report_from_state "$state_file" "$report"
    local existing_status
    existing_status=$(jq -r '.status' "$state_file")
    case "$existing_status" in
        ready_to_finish|completed)
            build_summary_payload "$state_file"
            return
            ;;
    esac
    local ts
    ts=$(now_iso)
    local time_short
    time_short=$(now_time)

    local unfinished has_failed has_blocked run_blocked
    unfinished=$(jq '[.steps[] | select(.status == "pending" or .status == "in_progress")] | length' "$state_file")
    has_failed=$(jq '[.steps[] | select(.status == "failed")] | length' "$state_file")
    has_blocked=$(jq '[.steps[] | select(.status == "blocked")] | length' "$state_file")
    run_blocked=$(jq 'if .status == "blocked" then 1 else 0 end' "$state_file")
    if [ "$unfinished" -gt 0 ] && [ "$has_failed" -eq 0 ] && [ "$has_blocked" -eq 0 ] && [ "$run_blocked" -eq 0 ]; then
        echo "ERROR: Cannot finalize run with unfinished steps ($unfinished remaining)" >&2
        exit 1
    fi

    local final_status="ready_to_finish"
    if [ "$has_failed" -gt 0 ] || [ "$has_blocked" -gt 0 ] || [ "$run_blocked" -gt 0 ]; then
        final_status="blocked"
    else
        local missing_verification missing_gates pending_actions missing_effect_evidence unresolved_effects failed_effects exceeded_budgets
        missing_verification=$(jq '[.steps[] | select((if .verify==null then false elif .verify.type=="shell" then ((.verify.command//"")|length)>0 else true end) and .verify.passed!=true)] | length' "$state_file")
        missing_gates=$(jq --arg risk "$(jq -r '.risk_level' "$state_file")" '[.steps[] | select((.gate!=null or $risk=="high" or .verify.type=="human-review") and (.gate_result!="approved" or ($risk=="high" and .gate_mode!="human")))] | length' "$state_file")
        pending_actions=$(jq '[.external_actions[]? | select(.status=="pending")] | length' "$state_file")
        missing_effect_evidence=$(jq '[.external_actions[]? | select((.kind=="external_write" or .kind=="production_change" or .kind=="secret_access") and .status=="approved" and (.effect==null or .effect_required==null or .idempotency_key==null))] | length' "$state_file")
        unresolved_effects=$(jq '[.external_actions[]? | select(.effect_required==true and .status=="approved" and (.effect.status!="succeeded" and .effect.status!="cancelled" and .effect.status!="failed"))] | length' "$state_file")
        failed_effects=$(jq '[.external_actions[]? | select(.effect_required==true and .effect.status=="failed")] | length' "$state_file")
        exceeded_budgets=$(jq '[.budgets.exceeded[]?] | length' "$state_file")

        if [ "$missing_verification" -gt 0 ]; then echo "ERROR: Cannot finalize without passing verification evidence" >&2; exit 1; fi
        if [ "$missing_gates" -gt 0 ]; then echo "ERROR: Cannot finalize without required gate evidence" >&2; exit 1; fi
        if [ "$pending_actions" -gt 0 ]; then echo "ERROR: Cannot finalize with unresolved sensitive action decisions" >&2; exit 1; fi
        if [ "$missing_effect_evidence" -gt 0 ] || [ "$unresolved_effects" -gt 0 ]; then echo "ERROR: Cannot finalize without terminal sensitive-action effect evidence" >&2; exit 1; fi
        if [ "$failed_effects" -gt 0 ]; then echo "ERROR: Cannot finalize a successful run with failed sensitive-action effects" >&2; exit 1; fi
        if [ "$exceeded_budgets" -gt 0 ]; then echo "ERROR: Cannot finalize while runtime budgets are exceeded" >&2; exit 1; fi
    fi

    local updated
    updated=$(jq --arg ts "$ts" --arg status "$final_status" '
        .status = $status |
        .finalized_at = $ts |
        .completed_at = (if $status == "blocked" then $ts else null end) |
        .last_update = $ts
    ' "$state_file")
    state_write "$state_file" "$updated"

    # Update report
    report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $final_status"
    report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
    report_append_event "$report" "**[$time_short]** Run finalized: $final_status"

    # Build summary payload
    local summary
    summary=$(build_summary_payload "$state_file")

    echo "$summary"
}

cmd_finish() {
    if [ $# -lt 1 ]; then
        echo "usage: hotl-rt finish <kept|merged|published|discarded> [--run-id <run-id>] [--target-branch <name>] [--remote <name>] [--pr-url <url>] [--branch-action <action>] [--worktree-action <action>] [--artifacts-preserved-at <path>] [--notes <text>] [--force]" >&2
        exit 1
    fi

    require_jq

    local disposition="$1"
    shift
    local run_id="${HOTL_RUN_ID:-}"
    local target_branch=""
    local remote=""
    local pr_url=""
    local branch_action=""
    local worktree_action=""
    local artifacts_preserved_at=""
    local notes=""
    local force=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --run-id)
                run_id="$2"
                shift 2
                ;;
            --target-branch)
                target_branch="$2"
                shift 2
                ;;
            --remote)
                remote="$2"
                shift 2
                ;;
            --pr-url)
                pr_url="$2"
                shift 2
                ;;
            --branch-action)
                branch_action="$2"
                shift 2
                ;;
            --worktree-action)
                worktree_action="$2"
                shift 2
                ;;
            --artifacts-preserved-at)
                artifacts_preserved_at="$2"
                shift 2
                ;;
            --notes)
                notes="$2"
                shift 2
                ;;
            --force)
                force=1
                shift
                ;;
            *)
                echo "ERROR: Unknown option for finish: $1" >&2
                exit 1
                ;;
        esac
    done

    case "$disposition" in
        kept|merged|published|discarded) ;;
        *)
            echo "ERROR: Unsupported finish disposition: $disposition" >&2
            exit 1
            ;;
    esac

    local state_file
    state_file=$(find_active_state "$run_id")
    acquire_run_lock "$(jq -r '.run_id' "$state_file")"
    enforce_controller_ownership "$state_file"
    local report
    report=$(report_path_from_state "$state_file")
    ensure_report_from_state "$state_file" "$report"
    local status
    status=$(jq -r '.status' "$state_file")
    local existing_disposition
    existing_disposition=$(jq -r '.finish.disposition // empty' "$state_file")

    if [ -n "$existing_disposition" ] && [ "$force" -ne 1 ]; then
        echo "ERROR: Finish outcome already recorded: $existing_disposition. Use --force to replace it." >&2
        exit 1
    fi

    case "$disposition" in
        merged|published)
            case "$status" in ready_to_finish|completed) ;; *) echo "ERROR: Finish disposition '$disposition' requires a completed run. Current status: $status" >&2; exit 1 ;; esac
            ;;
        kept|discarded)
            case "$status" in
                ready_to_finish|completed|blocked) ;;
                *)
                    echo "ERROR: Finish disposition '$disposition' requires a finalized run. Current status: $status" >&2
                    exit 1
                    ;;
            esac
            ;;
    esac

    if [ "$status" = ready_to_finish ] || [ "$status" = completed ]; then
        local pre_finish_receipt remaining_reasons
        pre_finish_receipt=$(cmd_receipt "$(jq -r '.run_id' "$state_file")" --json)
        remaining_reasons=$(jq '[.sufficiency.reasons[] | select(. != "finish_disposition_missing" and . != "run_not_completed")] | length' <<< "$pre_finish_receipt")
        if [ "$remaining_reasons" -ne 0 ]; then
            echo "ERROR: Finish disposition '$disposition' requires sufficient completion evidence." >&2
            jq -r '.sufficiency.reasons[] | select(. != "finish_disposition_missing" and . != "run_not_completed") | "  - \(.)"' <<< "$pre_finish_receipt" >&2
            exit 1
        fi
    fi

    local ts
    ts=$(now_iso)
    local time_short
    time_short=$(now_time)

    local updated
    updated=$(jq \
        --arg disposition "$disposition" \
        --arg ts "$ts" \
        --arg target_branch "$target_branch" \
        --arg remote "$remote" \
        --arg pr_url "$pr_url" \
        --arg branch_action "$branch_action" \
        --arg worktree_action "$worktree_action" \
        --arg artifacts_preserved_at "$artifacts_preserved_at" \
        --arg notes "$notes" '
        .last_update = $ts |
        .status = (if .status == "ready_to_finish" then "completed" else .status end) |
        .completed_at = (if .status == "completed" then $ts else .completed_at end) |
        .finish = {
            disposition: $disposition,
            recorded_at: $ts,
            target_branch: (if $target_branch == "" then null else $target_branch end),
            remote: (if $remote == "" then null else $remote end),
            pr_url: (if $pr_url == "" then null else $pr_url end),
            branch_action: (if $branch_action == "" then null else $branch_action end),
            worktree_action: (if $worktree_action == "" then null else $worktree_action end),
            artifacts_preserved_at: (if $artifacts_preserved_at == "" then null else $artifacts_preserved_at end),
            notes: (if $notes == "" then null else $notes end)
        }
    ' "$state_file")
    state_write "$state_file" "$updated"

    report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $(jq -r '.status' "$state_file")"
    report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
    report_append_event "$report" "**[$time_short]** Finish recorded: $disposition"

    local finish_lines=()
    finish_lines+=("**Disposition:** $disposition")
    finish_lines+=("**Recorded:** $ts")
    [ -n "$target_branch" ] && finish_lines+=("**Target Branch:** $target_branch")
    [ -n "$remote" ] && finish_lines+=("**Remote:** $remote")
    [ -n "$pr_url" ] && finish_lines+=("**PR URL:** $pr_url")
    [ -n "$branch_action" ] && finish_lines+=("**Branch Action:** $branch_action")
    [ -n "$worktree_action" ] && finish_lines+=("**Worktree Action:** $worktree_action")
    [ -n "$artifacts_preserved_at" ] && finish_lines+=("**Artifacts Preserved At:** $artifacts_preserved_at")
    [ -n "$notes" ] && finish_lines+=("**Notes:** $notes")
    report_write_finish_section "$report" "$(printf '%s\n' "${finish_lines[@]}")"

    build_summary_payload "$state_file"
}

cmd_summary() {
    if [ $# -lt 1 ]; then
        echo "usage: hotl-rt summary <run-id> [--json]" >&2
        exit 1
    fi

    require_jq

    local run_id="$1"
    local state_file
    state_file=$(state_path_for_run_id "$run_id") || exit 1

    if [ ! -f "$state_file" ]; then
        echo "ERROR: No state found for run: $run_id" >&2
        echo "Available runs:" >&2
        local available=0 candidate
        shopt -s nullglob
        for candidate in "$STATE_DIR"/*.json; do
            basename "$candidate" .json >&2
            available=1
        done
        shopt -u nullglob
        [ "$available" -eq 1 ] || echo "  (none)" >&2
        exit 1
    fi

    build_summary_payload "$state_file"
}

cmd_receipt() {
    if [ $# -lt 1 ]; then
        echo "usage: hotl-rt receipt <run-id> [--json]" >&2
        exit 1
    fi
    require_jq
    local run_id="$1"
    shift
    if [ $# -gt 0 ] && { [ "$1" != "--json" ] || [ $# -gt 1 ]; }; then
        echo "ERROR: Unknown option for receipt: $1" >&2
        exit 1
    fi
    local state_file
    state_file=$(state_path_for_run_id "$run_id") || exit 1
    [ -f "$state_file" ] || { echo "ERROR: No state found for run: $run_id" >&2; exit 1; }

    jq '
        . as $state |
        def verification_required:
            if .verify == null then false
            elif .verify.type == "shell" then ((.verify.command // "") | length) > 0
            else true end;
        def gate_required($risk): (.gate != null or $risk == "high" or .verify.type == "human-review");
        def reasons:
            ([if .status != "completed" then "run_not_completed" else empty end]
            + [if ([.steps[] | select(.status != "done")] | length) > 0 then "steps_not_done" else empty end]
            + [if ([.steps[] | select((verification_required) and (.verify.passed != true))] | length) > 0 then "verification_missing_or_failed" else empty end]
            + [if ([.steps[] | select(gate_required($state.risk_level) and .gate_result != "approved")] | length) > 0 then "gate_evidence_missing_or_rejected" else empty end]
            + [if $state.risk_level == "high" and ([.steps[] | select(.gate_mode != "human")] | length) > 0 then "high_risk_human_gate_missing" else empty end]
            + [if ([.external_actions[]? | select(.status == "pending")] | length) > 0 then "sensitive_action_unresolved" else empty end]
            + [if ([.external_actions[]? | select((.kind=="external_write" or .kind=="production_change" or .kind=="secret_access") and .status=="approved" and (.effect == null or .effect_required == null or .idempotency_key == null))] | length) > 0 then "sensitive_action_effect_evidence_missing" else empty end]
            + [if ([.external_actions[]? | select(.effect_required==true and .status=="approved" and (.effect.status != "succeeded" and .effect.status != "cancelled" and .effect.status != "failed"))] | length) > 0 then "sensitive_action_effect_unresolved" else empty end]
            + [if ([.external_actions[]? | select(.effect_required==true and .effect.status=="failed")] | length) > 0 then "sensitive_action_effect_failed" else empty end]
            + [if ([.budgets.exceeded[]?] | length) > 0 then "budget_exceeded" else empty end]
            + [if (.finish.disposition // null) == null then "finish_disposition_missing" else empty end]);
        (reasons) as $reasons |
        {
            schema: "hotl.receipt/v1",
            generated_at: .last_update,
            run: {
                id: .run_id,
                workflow_path: .workflow_path,
                source_workflow_path: .source_workflow_path,
                workflow_slug: .workflow_slug,
                intent: .intent,
                risk_level: .risk_level,
                branch: .branch,
                repo_root: .repo_root,
                execution_root: .execution_root,
                worktree_path: .worktree_path,
                executor_mode: .executor_mode,
                status: .status,
                started_at: .started_at,
                completed_at: .completed_at
            },
            implementation: {driver: (.driver // "generic"), host: (.host // "fallback")},
            controller: {
                status: (.controller.status // "legacy-unclaimed"),
                owner_id: (.controller.owner_id // null),
                claimed_at: (.controller.claimed_at // null),
                heartbeat_at: (.controller.heartbeat_at // null),
                lease_expires_epoch: (.controller.lease_expires_epoch // null)
            },
            evidence: [.steps[] | {
                step: .number,
                name: .name,
                status: .status,
                attempts: .attempts,
                verification: {
                    required: verification_required,
                    type: .verify.type,
                    reference: (.verify.command // .verify.path // .verify.url // .verify.prompt // null),
                    passed: .verify.passed
                },
                gate: {
                    required: gate_required($state.risk_level),
                    required_mode: (if $state.risk_level == "high" then "human" else null end),
                    configured: .gate,
                    result: .gate_result,
                    mode: .gate_mode
                },
                block_reason: .block_reason
            }],
            policy: (.policy // {profile: "standard", sensitive_actions: "human"}),
            budgets: (.budgets // {limits: {}, observed: {}, exceeded: []}),
            external_actions: [.external_actions[]? | {
                id: .id, kind: .kind, target: .target, status: .status,
                requested_at: .requested_at, decided_at: .decided_at,
                decision_mode: .decision_mode,
                effect_required: (.effect_required // null),
                idempotency_key: (.idempotency_key // null),
                effect: (.effect // null)
            }],
            finish: .finish,
            sufficiency: {sufficient: ($reasons | length == 0), reasons: $reasons},
            redaction: {stdout_included: false, stderr_included: false, environment_included: false}
        }
    ' "$state_file"
}

cmd_owner() {
    [ $# -ge 1 ] || { echo "usage: hotl-rt owner <claim|status|heartbeat|handoff|release|takeover> ..." >&2; exit 1; }
    require_jq
    local operation="$1"
    shift
    local run_id="${HOTL_RUN_ID:-}" owner_id="" token="${HOTL_OWNER_TOKEN:-}" to_owner="" reason=""
    local lease_seconds=300 force=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --run-id) run_id="$2"; shift 2 ;;
            --owner) owner_id="$2"; shift 2 ;;
            --token) token="$2"; shift 2 ;;
            --to-owner) to_owner="$2"; shift 2 ;;
            --reason) reason="$2"; shift 2 ;;
            --lease-seconds) lease_seconds="$2"; shift 2 ;;
            --force) force=1; shift ;;
            *) echo "ERROR: Unknown owner option: $1" >&2; exit 1 ;;
        esac
    done

    [[ "$lease_seconds" =~ ^[1-9][0-9]*$ ]] && [ "$lease_seconds" -le 604800 ] || {
        echo "ERROR: --lease-seconds must be an integer from 1 to 604800" >&2
        exit 1
    }

    local state_file
    state_file=$(find_active_state "$run_id")
    if [ "$operation" = status ]; then
        local now_epoch
        now_epoch=$(date -u +%s)
        jq --argjson now "$now_epoch" '{
            status:(if (.controller.status // "legacy-unclaimed") == "active" and (.controller.lease_expires_epoch // 0) <= $now then "stale" else (.controller.status // "legacy-unclaimed") end),
            owner_id:(.controller.owner_id // null),
            claimed_at:(.controller.claimed_at // null),
            heartbeat_at:(.controller.heartbeat_at // null),
            lease_expires_epoch:(.controller.lease_expires_epoch // null),
            released_at:(.controller.released_at // null)
        }' "$state_file"
        return
    fi

    acquire_run_lock "$(jq -r '.run_id' "$state_file")"
    local report ts now_epoch expires_epoch updated new_token token_hash current_status
    report=$(report_path_from_state "$state_file")
    ensure_report_from_state "$state_file" "$report"
    ts=$(now_iso)
    now_epoch=$(date -u +%s)
    expires_epoch=$((now_epoch + lease_seconds))
    current_status=$(jq -r '.controller.status // "legacy-unclaimed"' "$state_file")

    case "$operation" in
        claim)
            [[ "$owner_id" =~ ^[A-Za-z0-9][A-Za-z0-9._:@-]*$ ]] || { echo "ERROR: --owner must be a stable controller identity" >&2; exit 1; }
            if [ "$current_status" = active ]; then
                if [ "$(jq -r '.controller.lease_expires_epoch // 0' "$state_file")" -gt "$now_epoch" ]; then
                    echo "ERROR: Run already has an active controller: $(jq -r '.controller.owner_id' "$state_file")" >&2
                else
                    echo "ERROR: Previous controller lease is stale; use owner takeover with a reason" >&2
                fi
                exit 1
            fi
            new_token=$(new_owner_token "$state_file")
            token_hash=$(sha256_text "$new_token")
            updated=$(jq --arg owner "$owner_id" --arg hash "$token_hash" --arg ts "$ts" --argjson expires "$expires_epoch" '
                .controller={status:"active",owner_id:$owner,token_sha256:$hash,claimed_at:$ts,heartbeat_at:$ts,lease_expires_epoch:$expires,released_at:null} |
                .ownership_history=((.ownership_history // []) + [{event:"claim",owner_id:$owner,at:$ts,reason:null}]) |
                .last_update=$ts
            ' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$(now_time)]** Controller claimed: $owner_id"
            jq -cn --arg owner "$owner_id" --arg token "$new_token" --argjson expires "$expires_epoch" '{status:"active",owner_id:$owner,token:$token,lease_expires_epoch:$expires}'
            ;;
        heartbeat)
            [ "$current_status" = active ] || { echo "ERROR: No active controller to heartbeat" >&2; exit 1; }
            [ -n "$token" ] && [ "$(sha256_text "$token")" = "$(jq -r '.controller.token_sha256 // empty' "$state_file")" ] || { echo "ERROR: Invalid controller ownership token" >&2; exit 1; }
            updated=$(jq --arg ts "$ts" --argjson expires "$expires_epoch" '
                .controller.heartbeat_at=$ts | .controller.lease_expires_epoch=$expires | .last_update=$ts
            ' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            jq -cn --arg owner "$(jq -r '.controller.owner_id' "$state_file")" --argjson expires "$expires_epoch" '{status:"active",owner_id:$owner,heartbeat_at:now|todate,lease_expires_epoch:$expires}'
            ;;
        release)
            [ "$current_status" = active ] || { echo "ERROR: No active controller to release" >&2; exit 1; }
            [ -n "$token" ] && [ "$(sha256_text "$token")" = "$(jq -r '.controller.token_sha256 // empty' "$state_file")" ] || { echo "ERROR: Invalid controller ownership token" >&2; exit 1; }
            owner_id=$(jq -r '.controller.owner_id' "$state_file")
            updated=$(jq --arg owner "$owner_id" --arg ts "$ts" '
                .controller.status="released" | .controller.token_sha256=null | .controller.lease_expires_epoch=null | .controller.released_at=$ts |
                .ownership_history=((.ownership_history // []) + [{event:"release",owner_id:$owner,at:$ts,reason:null}]) | .last_update=$ts
            ' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$(now_time)]** Controller released: $owner_id"
            jq -cn --arg owner "$owner_id" '{status:"released",owner_id:$owner}'
            ;;
        handoff)
            [ "$current_status" = active ] || { echo "ERROR: No active controller to hand off" >&2; exit 1; }
            [ -n "$token" ] && [ "$(sha256_text "$token")" = "$(jq -r '.controller.token_sha256 // empty' "$state_file")" ] || { echo "ERROR: Invalid controller ownership token" >&2; exit 1; }
            [[ "$to_owner" =~ ^[A-Za-z0-9][A-Za-z0-9._:@-]*$ ]] || { echo "ERROR: --to-owner must be a stable controller identity" >&2; exit 1; }
            owner_id=$(jq -r '.controller.owner_id' "$state_file")
            new_token=$(new_owner_token "$state_file"); token_hash=$(sha256_text "$new_token")
            updated=$(jq --arg from "$owner_id" --arg owner "$to_owner" --arg hash "$token_hash" --arg ts "$ts" --argjson expires "$expires_epoch" '
                .controller={status:"active",owner_id:$owner,token_sha256:$hash,claimed_at:$ts,heartbeat_at:$ts,lease_expires_epoch:$expires,released_at:null} |
                .ownership_history=((.ownership_history // []) + [{event:"handoff",owner_id:$owner,from_owner:$from,at:$ts,reason:null}]) | .last_update=$ts
            ' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$(now_time)]** Controller handoff: $owner_id → $to_owner"
            jq -cn --arg owner "$to_owner" --arg token "$new_token" --argjson expires "$expires_epoch" '{status:"active",owner_id:$owner,token:$token,lease_expires_epoch:$expires}'
            ;;
        takeover)
            [[ "$owner_id" =~ ^[A-Za-z0-9][A-Za-z0-9._:@-]*$ ]] || { echo "ERROR: --owner must be a stable controller identity" >&2; exit 1; }
            [ -n "$reason" ] || { echo "ERROR: owner takeover requires --reason" >&2; exit 1; }
            if [ "$current_status" = active ] && [ "$(jq -r '.controller.lease_expires_epoch // 0' "$state_file")" -gt "$now_epoch" ] && [ "$force" -ne 1 ]; then
                echo "ERROR: Controller lease is still active; use --force only after explicit human review" >&2
                exit 1
            fi
            local previous_owner
            previous_owner=$(jq -r '.controller.owner_id // empty' "$state_file")
            new_token=$(new_owner_token "$state_file"); token_hash=$(sha256_text "$new_token")
            updated=$(jq --arg previous "$previous_owner" --arg owner "$owner_id" --arg hash "$token_hash" --arg ts "$ts" --arg reason "$reason" --argjson expires "$expires_epoch" --argjson forced "$force" '
                .controller={status:"active",owner_id:$owner,token_sha256:$hash,claimed_at:$ts,heartbeat_at:$ts,lease_expires_epoch:$expires,released_at:null} |
                .ownership_history=((.ownership_history // []) + [{event:"takeover",owner_id:$owner,from_owner:(if $previous=="" then null else $previous end),at:$ts,reason:$reason,forced:($forced==1)}]) | .last_update=$ts
            ' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$(now_time)]** Controller takeover: ${previous_owner:-unclaimed} → $owner_id ($reason)"
            jq -cn --arg owner "$owner_id" --arg token "$new_token" --argjson expires "$expires_epoch" '{status:"active",owner_id:$owner,token:$token,lease_expires_epoch:$expires}'
            ;;
        *) echo "ERROR: Unknown owner operation: $operation" >&2; exit 1 ;;
    esac
}

cmd_action() {
    [ $# -ge 1 ] || { echo "usage: hotl-rt action <request|decide|begin|complete|reconcile> ..." >&2; exit 1; }
    require_jq
    local operation="$1"
    shift
    local run_id="${HOTL_RUN_ID:-}" state_file report ts updated

    case "$operation" in
        request)
            [ $# -ge 1 ] || { echo "usage: hotl-rt action request <kind> --target <description> [--idempotency-key <key>] [--run-id <id>]" >&2; exit 1; }
            local kind="$1" target="" idempotency_key=""
            shift
            while [ $# -gt 0 ]; do
                case "$1" in
                    --target) target="$2"; shift 2 ;;
                    --idempotency-key) idempotency_key="$2"; shift 2 ;;
                    --run-id) run_id="$2"; shift 2 ;;
                    *) echo "ERROR: Unknown action request option: $1" >&2; exit 1 ;;
                esac
            done
            case "$kind" in local_write|network_read|external_write|production_change|secret_access) ;; *) echo "ERROR: Unsupported action kind: $kind" >&2; exit 1 ;; esac
            [ -n "$target" ] || { echo "ERROR: --target is required and must describe the bounded action" >&2; exit 1; }
            if [ -n "$idempotency_key" ] && [[ ! "$idempotency_key" =~ ^[A-Za-z0-9][A-Za-z0-9._:@/-]*$ ]]; then
                echo "ERROR: Invalid idempotency key" >&2
                exit 1
            fi
            state_file=$(find_active_state "$run_id")
            acquire_run_lock "$(jq -r '.run_id' "$state_file")"
            enforce_controller_ownership "$state_file"
            report=$(report_path_from_state "$state_file"); ensure_report_from_state "$state_file" "$report"
            [ "$(jq -r '.status' "$state_file")" != completed ] || { echo "ERROR: Cannot request an action for a completed run" >&2; exit 1; }

            if [ -n "$idempotency_key" ] && jq -e --arg key "$idempotency_key" '.external_actions[]? | select(.idempotency_key == $key)' "$state_file" >/dev/null; then
                local existing
                existing=$(jq -c --arg key "$idempotency_key" '.external_actions[] | select(.idempotency_key == $key)' "$state_file")
                [ "$(jq -r '.kind' <<< "$existing")" = "$kind" ] && [ "$(jq -r '.target' <<< "$existing")" = "$target" ] || {
                    echo "ERROR: Idempotency key already belongs to a different bounded action" >&2
                    exit 1
                }
                jq '{id,status,decision_mode,idempotency_key,effect_status:(.effect.status // "evidence_missing"),deduplicated:true}' <<< "$existing"
                return
            fi

            ts=$(now_iso)
            local action_status="allowed" mode="policy" effect_required=false effect_status="not_required"
            case "$kind" in
                external_write|production_change|secret_access) action_status="pending"; mode="human"; effect_required=true; effect_status="not_started" ;;
                network_read) action_status="host_authority"; mode="host" ;;
            esac
            local action_id
            action_id="action-$(( $(jq '(.external_actions // []) | length' "$state_file") + 1 ))"
            if [ "$effect_required" = true ] && [ -z "$idempotency_key" ]; then
                idempotency_key="$(jq -r '.run_id' "$state_file"):${action_id}"
            fi
            updated=$(jq --arg id "$action_id" --arg kind "$kind" --arg target "$target" --arg status "$action_status" --arg mode "$mode" --arg key "$idempotency_key" --arg effect_status "$effect_status" --argjson effect_required "$effect_required" --arg ts "$ts" '
                .external_actions = ((.external_actions // []) + [{
                    id:$id,kind:$kind,target:$target,status:$status,requested_at:$ts,decided_at:null,decision_mode:$mode,
                    effect_required:$effect_required,idempotency_key:(if $key=="" then null else $key end),
                    effect:{status:$effect_status,intent_recorded_at:null,completed_at:null,evidence_ref:null}
                }]) |
                .policy_pauses = (if $status == "pending" then ((.policy_pauses // []) + [$id] | unique) else (.policy_pauses // []) end) |
                .status = (if $status == "pending" and .status == "running" then "paused" else .status end) |
                .last_update = $ts
            ' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            [ "$action_status" != pending ] || report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $(jq -r '.status' "$state_file")"
            report_append_event "$report" "**[$(now_time)]** Action $action_id requested: $kind ($action_status)"
            jq -cn --arg id "$action_id" --arg status "$action_status" --arg mode "$mode" --arg key "$idempotency_key" --arg effect "$effect_status" '{id:$id,status:$status,decision_mode:$mode,idempotency_key:(if $key=="" then null else $key end),effect_status:$effect}'
            ;;
        decide)
            [ $# -ge 2 ] || { echo "usage: hotl-rt action decide <action-id> <approved|rejected> --mode human [--run-id <id>]" >&2; exit 1; }
            local action_id="$1" decision="$2" decision_mode=""
            shift 2
            while [ $# -gt 0 ]; do
                case "$1" in --mode) decision_mode="$2"; shift 2 ;; --run-id) run_id="$2"; shift 2 ;; *) echo "ERROR: Unknown action decision option: $1" >&2; exit 1 ;; esac
            done
            case "$decision" in approved|rejected) ;; *) echo "ERROR: Decision must be approved or rejected" >&2; exit 1 ;; esac
            [ "$decision_mode" = human ] || { echo "ERROR: Sensitive action decisions require --mode human" >&2; exit 1; }
            state_file=$(find_active_state "$run_id"); acquire_run_lock "$(jq -r '.run_id' "$state_file")"; enforce_controller_ownership "$state_file"
            report=$(report_path_from_state "$state_file"); ensure_report_from_state "$state_file" "$report"
            jq -e --arg id "$action_id" '.external_actions[]? | select(.id == $id and .status == "pending")' "$state_file" >/dev/null || { echo "ERROR: Pending action not found: $action_id" >&2; exit 1; }
            ts=$(now_iso)
            updated=$(jq --arg id "$action_id" --arg decision "$decision" --arg mode "$decision_mode" --arg ts "$ts" '
                .external_actions |= map(if .id == $id then .status=$decision | .decided_at=$ts | .decision_mode=$mode else . end) |
                .policy_pauses = [(.policy_pauses // [])[] | select(. != $id)] |
                .status = (if $decision == "rejected" then "blocked"
                    elif .status == "paused" and (.policy_pauses|length) == 0
                      and ([.steps[] | select(.status == "blocked")] | length) == 0
                      and ([.budgets.exceeded[]?] | length) == 0 then "running" else .status end) |
                .last_update = $ts
            ' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $(jq -r '.status' "$state_file")"
            report_append_event "$report" "**[$(now_time)]** Action $action_id decision: $decision (human)"
            jq -cn --arg id "$action_id" --arg decision "$decision" '{id:$id,status:$decision,decision_mode:"human"}'
            ;;
        begin)
            [ $# -ge 1 ] || { echo "usage: hotl-rt action begin <action-id> --idempotency-key <key> [--run-id <id>]" >&2; exit 1; }
            local action_id="$1" supplied_key=""
            shift
            while [ $# -gt 0 ]; do
                case "$1" in --idempotency-key) supplied_key="$2"; shift 2 ;; --run-id) run_id="$2"; shift 2 ;; *) echo "ERROR: Unknown action begin option: $1" >&2; exit 1 ;; esac
            done
            state_file=$(find_active_state "$run_id"); acquire_run_lock "$(jq -r '.run_id' "$state_file")"; enforce_controller_ownership "$state_file"
            report=$(report_path_from_state "$state_file"); ensure_report_from_state "$state_file" "$report"
            jq -e --arg id "$action_id" --arg key "$supplied_key" '.external_actions[]? | select(.id==$id and .status=="approved" and .effect_required==true and .idempotency_key==$key and .effect.status=="not_started")' "$state_file" >/dev/null || {
                echo "ERROR: Action is not approved and ready, the idempotency key mismatches, or its effect may already have started" >&2; exit 1;
            }
            ts=$(now_iso)
            updated=$(jq --arg id "$action_id" --arg ts "$ts" '.external_actions |= map(if .id==$id then .effect.status="in_progress" | .effect.intent_recorded_at=$ts else . end) | .last_update=$ts' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$(now_time)]** Action $action_id effect intent recorded (in_progress)"
            jq -cn --arg id "$action_id" '{id:$id,effect_status:"in_progress"}'
            ;;
        complete|reconcile)
            [ $# -ge 2 ] || { echo "usage: hotl-rt action $operation <action-id> <succeeded|failed|uncertain|cancelled> --evidence-ref <reference> [--run-id <id>]" >&2; exit 1; }
            local action_id="$1" outcome="$2" evidence_ref=""
            shift 2
            while [ $# -gt 0 ]; do
                case "$1" in --evidence-ref) evidence_ref="$2"; shift 2 ;; --run-id) run_id="$2"; shift 2 ;; *) echo "ERROR: Unknown action $operation option: $1" >&2; exit 1 ;; esac
            done
            if [ "$operation" = complete ]; then
                case "$outcome" in succeeded|failed|uncertain|cancelled) ;; *) echo "ERROR: Invalid effect outcome: $outcome" >&2; exit 1 ;; esac
            else
                case "$outcome" in succeeded|failed|cancelled) ;; *) echo "ERROR: Reconciliation requires a terminal observed outcome" >&2; exit 1 ;; esac
            fi
            [ -n "$evidence_ref" ] || { echo "ERROR: --evidence-ref is required for effect outcomes" >&2; exit 1; }
            state_file=$(find_active_state "$run_id"); acquire_run_lock "$(jq -r '.run_id' "$state_file")"; enforce_controller_ownership "$state_file"
            report=$(report_path_from_state "$state_file"); ensure_report_from_state "$state_file" "$report"
            if [ "$operation" = complete ]; then
                jq -e --arg id "$action_id" '.external_actions[]? | select(.id==$id and .effect.status=="in_progress")' "$state_file" >/dev/null || { echo "ERROR: Effect is not in_progress" >&2; exit 1; }
            else
                jq -e --arg id "$action_id" '.external_actions[]? | select(.id==$id and .status=="approved" and ((.effect.status=="in_progress" or .effect.status=="uncertain") or (.effect==null and (.kind=="external_write" or .kind=="production_change" or .kind=="secret_access"))))' "$state_file" >/dev/null || { echo "ERROR: Effect does not require reconciliation" >&2; exit 1; }
            fi
            ts=$(now_iso)
            updated=$(jq --arg id "$action_id" --arg outcome "$outcome" --arg evidence "$evidence_ref" --arg ts "$ts" --arg run_id "$(jq -r '.run_id' "$state_file")" '
                .external_actions |= map(
                    if .id==$id then
                        if .effect==null then
                            .effect_required=true |
                            .idempotency_key=(.idempotency_key // ($run_id+":"+$id+":legacy-reconcile")) |
                            .effect={status:$outcome,intent_recorded_at:null,completed_at:$ts,evidence_ref:$evidence}
                        else
                            .effect.status=$outcome | .effect.completed_at=$ts | .effect.evidence_ref=$evidence
                        end
                    else . end
                ) |
                .policy_pauses = (if $outcome=="uncertain" then ((.policy_pauses // []) + ["effect:"+$id] | unique) else [(.policy_pauses // [])[] | select(. != ("effect:"+$id))] end) |
                .status = (if $outcome=="failed" then "blocked"
                    elif $outcome=="uncertain" then "paused"
                    elif .status=="paused" and (.policy_pauses|length)==0 and ([.budgets.exceeded[]?]|length)==0 and ([.steps[]|select(.status=="blocked")]|length)==0 then "running"
                    else .status end) | .last_update=$ts
            ' "$state_file")
            state_write "$state_file" "$updated"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $(jq -r '.status' "$state_file")"
            report_append_event "$report" "**[$(now_time)]** Action $action_id effect $operation: $outcome ($evidence_ref)"
            jq -cn --arg id "$action_id" --arg outcome "$outcome" --arg evidence "$evidence_ref" '{id:$id,effect_status:$outcome,evidence_ref:$evidence}'
            ;;
        *) echo "ERROR: Unknown action operation: $operation" >&2; exit 1 ;;
    esac
}

cmd_budget() {
    [ $# -ge 1 ] || { echo "usage: hotl-rt budget <record|check> ..." >&2; exit 1; }
    require_jq
    local operation="$1"; shift
    local run_id="${HOTL_RUN_ID:-}" state_file updated ts
    case "$operation" in
        record)
            [ $# -ge 2 ] || { echo "usage: hotl-rt budget record <agents|cost_usd|elapsed_minutes> <value> [--run-id <id>]" >&2; exit 1; }
            local metric="$1" value="$2"; shift 2
            [ $# -eq 0 ] || { [ "$1" = --run-id ] && [ $# -eq 2 ] || { echo "ERROR: Invalid budget record options" >&2; exit 1; }; run_id="$2"; }
            case "$metric" in agents|cost_usd|elapsed_minutes) ;; *) echo "ERROR: Unsupported budget metric: $metric" >&2; exit 1 ;; esac
            jq -en --arg value "$value" '$value | tonumber | select(. >= 0)' >/dev/null || { echo "ERROR: Budget observations must be non-negative numbers" >&2; exit 1; }
            state_file=$(find_active_state "$run_id"); ts=$(now_iso)
            acquire_run_lock "$(jq -r '.run_id' "$state_file")"
            enforce_controller_ownership "$state_file"
            enforce_execution_evidence_mutable "$state_file" "budget record"
            local previous
            previous=$(jq -r --arg metric "$metric" '.budgets.observed[$metric] // empty' "$state_file")
            if [ -n "$previous" ] && ! jq -en --arg old "$previous" --arg new "$value" '($new|tonumber) >= ($old|tonumber)' >/dev/null; then
                echo "ERROR: Budget observations are aggregate and cannot decrease ($metric: $previous -> $value)" >&2
                exit 1
            fi
            updated=$(jq --arg metric "$metric" --arg value "$value" --arg ts "$ts" '.budgets.observed[$metric]=($value|tonumber) | .last_update=$ts' "$state_file")
            state_write "$state_file" "$updated"
            cmd_budget check --run-id "$(jq -r '.run_id' "$state_file")"
            ;;
        check)
            if [ $# -gt 0 ]; then [ "$1" = --run-id ] && [ $# -eq 2 ] || { echo "ERROR: Invalid budget check options" >&2; exit 1; }; run_id="$2"; fi
            state_file=$(find_active_state "$run_id"); ts=$(now_iso)
            acquire_run_lock "$(jq -r '.run_id' "$state_file")"
            enforce_controller_ownership "$state_file"
            enforce_execution_evidence_mutable "$state_file" "budget check"
            local evaluation
            evaluation=$(jq '
                (.budgets.limits // {}) as $limits |
                (.budgets.observed // {}) as $observed |
                ([.steps[].attempts] | add // 0) as $attempts |
                [{metric:"total_attempts",limit:($limits.total_attempts//null),observed:$attempts},
                 {metric:"agents",limit:($limits.agents//null),observed:($observed.agents//null)},
                 {metric:"cost_usd",limit:($limits.cost_usd//null),observed:($observed.cost_usd//null)},
                 {metric:"elapsed_minutes",limit:($limits.elapsed_minutes//null),observed:($observed.elapsed_minutes//null)}]
                | map(. + {status:(if .limit==null then "unset" elif .observed==null then "unknown" elif .observed>.limit then "exceeded" else "within" end)})
            ' "$state_file")
            local exceeded
            exceeded=$(jq '[.[] | select(.status=="exceeded") | .metric]' <<< "$evaluation")
            updated=$(jq --argjson exceeded "$exceeded" --arg ts "$ts" '.budgets.exceeded=$exceeded | .status=(if ($exceeded|length)>0 and .status=="running" then "paused" else .status end) | .last_update=$ts' "$state_file")
            state_write "$state_file" "$updated"
            local budget_report
            budget_report=$(report_path_from_state "$state_file")
            ensure_report_from_state "$state_file" "$budget_report"
            report_update_line "$budget_report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            if [ "$(jq 'length' <<< "$exceeded")" -gt 0 ]; then
                report_update_line "$budget_report" "^\*\*Status:\*\*.*" "**Status:** $(jq -r '.status' "$state_file")"
                report_append_event "$budget_report" "**[$(now_time)]** Budget exceeded: $(jq -r 'join(", ")' <<< "$exceeded")"
            fi
            jq -cn --argjson metrics "$evaluation" '{metrics:$metrics,within_budget:([$metrics[]|select(.status=="exceeded")]|length==0),has_unknown:([$metrics[]|select(.status=="unknown")]|length>0)}'
            ;;
        *) echo "ERROR: Unknown budget operation: $operation" >&2; exit 1 ;;
    esac
}

cmd_reconcile() {
    [ $# -eq 1 ] || { echo "usage: hotl-rt reconcile <run-id>" >&2; exit 1; }
    require_jq
    local run_id="$1" state_file
    state_file=$(state_path_for_run_id "$run_id") || exit 1
    [ -f "$state_file" ] || { echo "ERROR: No state found for run: $run_id" >&2; exit 1; }
    local receipt
    receipt=$(cmd_receipt "$run_id" --json)
    jq -cn --argjson receipt "$receipt" '
        ($receipt.external_actions | map(select(.status=="pending")) | length) as $pending_actions |
        ($receipt.external_actions | map(select(.status=="approved" and ((.effect.status=="in_progress" or .effect.status=="uncertain") or .effect==null))) | length) as $effects_to_reconcile |
        ($receipt.external_actions | map(select(.status=="approved" and .effect.status=="not_started")) | length) as $effects_to_execute |
        ($receipt.budgets.exceeded | length) as $exceeded |
        ($receipt.evidence | map(select(.status=="failed")) | length) as $failed |
        {schema:"hotl.reconciliation/v1",run_id:$receipt.run.id,status:$receipt.run.status,sufficient:$receipt.sufficiency.sufficient,
         unresolved_actions:$pending_actions,exceeded_budgets:$receipt.budgets.exceeded,
         next_action:(if $receipt.sufficiency.sufficient then "complete"
          elif $pending_actions>0 then "await_action_decision"
          elif $effects_to_reconcile>0 then "reconcile_action_effect"
          elif $effects_to_execute>0 then "execute_approved_action"
          elif $exceeded>0 then "adjust_budget_or_stop"
          elif $receipt.run.status=="blocked" then "inspect_blocker"
          elif $receipt.run.status=="paused" then "resume_after_gate_or_policy"
          elif $failed>0 then "retry_or_block_failed_step"
          elif $receipt.run.status=="ready_to_finish" and ([$receipt.sufficiency.reasons[] | select(.!="run_not_completed" and .!="finish_disposition_missing")] | length)==0 then "record_finish_disposition"
          elif $receipt.run.status=="completed" and ($receipt.sufficiency.reasons==["finish_disposition_missing"]) then "record_finish_disposition"
          else "verify_next_incomplete_step" end),
         reasons:$receipt.sufficiency.reasons}'
}

# ── log-decision ────────────────────────────────────────────────────────────

# Append an autonomous-decision record to the configured log. Opt-in only:
# when decision_log_path is unset in .hotl/config.yml (or the file is absent),
# this is a no-op and no file is created.
#
# The path is resolved via scripts/hotl-config-resolve.sh — hotl-rt must NOT
# parse .hotl/config.yml directly.
cmd_log_decision() {
    if [ $# -lt 1 ]; then
        echo "ERROR: log-decision requires a JSON argument" >&2
        echo "usage: hotl-rt log-decision <json-string>" >&2
        exit 1
    fi
    local json="$1"

    local resolver="$SCRIPT_DIR/../scripts/hotl-config-resolve.sh"
    if [ ! -f "$resolver" ]; then
        echo "ERROR: hotl-config-resolve.sh not found at $resolver" >&2
        exit 1
    fi

    local log_path
    log_path=$(bash "$resolver" get decision_log_path)

    # Opt-in: empty path means logging is disabled — no file created.
    if [ -z "$log_path" ]; then
        return 0
    fi

    local dir
    dir=$(dirname "$log_path")
    [ -n "$dir" ] && [ "$dir" != "." ] && mkdir -p "$dir"

    printf '%s\n' "$json" >> "$log_path"
}

# ── Dispatcher ──────────────────────────────────────────────────────────────

usage() {
    cat <<'USAGE'
usage: hotl-rt <command> [args]

commands:
  normalize <workflow-file> [--json]    Emit read-only normalized workflow JSON
  init <workflow-file> [--require-owner] [--executor-mode <mode>] [--driver <id>] [--host <id>] [--repo-root <path>]
       [--execution-root <path>] [--source-workflow-path <path>]
       [--worktree-path <path>] [--branch <name>]
                                        Initialize a run from a workflow file
  step <N> start [--run-id <run-id>]    Mark step N as in-progress
  step <N> verify [--run-id <run-id>]   Run verify command, auto-transition to done/fail
  step <N> retry [--run-id <run-id>]    Reset failed step to in-progress for retry
  step <N> block --reason "..." [--run-id <run-id>]
                                        Mark step as blocked with reason
  gate <N> <approved|rejected> [--mode auto|human] [--run-id <run-id>]
                                        Record gate decision
  finalize [--json] [--run-id <run-id>] Finalize run, print summary payload
  finish <kept|merged|published|discarded> [--run-id <run-id>]
       [--target-branch <name>] [--remote <name>] [--pr-url <url>]
       [--branch-action <action>] [--worktree-action <action>]
       [--artifacts-preserved-at <path>] [--notes <text>] [--force]
                                        Record the post-execution disposition
  summary <run-id> [--json]             Read-only summary for any run
  receipt <run-id> [--json]             Emit a state-derived evidence receipt
  owner <claim|status|heartbeat|handoff|release|takeover>
                                        Coordinate a renewable run controller
  action request <kind> --target <text> [--idempotency-key <key>]
                                        Record and gate a bounded action
  action decide <id> <approved|rejected> --mode human
                                        Record a sensitive-action decision
  action begin <id> --idempotency-key <key>
                                        Persist intent before a sensitive effect
  action complete <id> <outcome> --evidence-ref <reference>
  action reconcile <id> <outcome> --evidence-ref <reference>
                                        Persist observed effect outcomes
  budget record <metric> <value>        Record observed budget telemetry
  budget check [--run-id <run-id>]      Evaluate configured run budgets
  reconcile <run-id>                    Recommend a verify-first recovery action
  log-decision <json>                   Append a JSON line to the configured
                                        decision log. No-op when
                                        decision_log_path is unset.

HOTL shared runtime — owns state persistence and verification.
Agents call this; they don't replicate it.
USAGE
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
    normalize)      cmd_normalize "$@" ;;
    init)           cmd_init "$@" ;;
    step)           cmd_step "$@" ;;
    gate)           cmd_gate "$@" ;;
    finalize)       cmd_finalize "$@" ;;
    finish)         cmd_finish "$@" ;;
    summary)        cmd_summary "$@" ;;
    receipt)        cmd_receipt "$@" ;;
    owner)          cmd_owner "$@" ;;
    action)         cmd_action "$@" ;;
    budget)         cmd_budget "$@" ;;
    reconcile)      cmd_reconcile "$@" ;;
    log-decision)   cmd_log_decision "$@" ;;
    --help|-h|help) usage ;;
    *)
        echo "ERROR: Unknown command: $COMMAND" >&2
        usage
        exit 1
        ;;
esac
