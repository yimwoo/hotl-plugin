# Populate the caller's workflow metadata and step arrays. Bash uses dynamic
# scope for these variables, allowing init and normalize to share one parser.
parse_workflow_file() {
    local workflow_file="$1"
    local branch_override="${2:-}"
    local frontmatter content

    frontmatter=$(sed -n '/^---$/,/^---$/p' "$workflow_file" | sed '1d;$d')
    fm_intent=$(echo "$frontmatter" | { grep -i '^intent:' || true; } | sed 's/^[Ii]ntent:[[:space:]]*//')
    fm_success=$(echo "$frontmatter" | { grep -i '^success_criteria:' || true; } | sed 's/^[Ss]uccess_criteria:[[:space:]]*//')
    fm_risk=$(echo "$frontmatter" | { grep -i '^risk_level:' || true; } | sed 's/^[Rr]isk_level:[[:space:]]*//')
    [ -z "$fm_risk" ] && fm_risk="low"
    fm_auto=$(echo "$frontmatter" | { grep -i '^auto_approve:' || true; } | sed 's/^[Aa]uto_approve:[[:space:]]*//')
    [ -z "$fm_auto" ] && fm_auto="false"
    case "$fm_risk" in low|medium|high) ;; *) echo "ERROR: risk_level must be low, medium, or high" >&2; return 1 ;; esac
    case "$fm_auto" in true|false) ;; *) echo "ERROR: auto_approve must be true or false" >&2; return 1 ;; esac
    fm_branch=$(echo "$frontmatter" | { grep -i '^branch:' || true; } | sed 's/^[Bb]ranch:[[:space:]]*//')
    [ -z "$fm_branch" ] && fm_branch="hotl/${workflow_slug}"
    [ -n "$branch_override" ] && fm_branch="$branch_override"
    fm_policy_profile=$(echo "$frontmatter" | { grep -i '^policy_profile:' || true; } | sed 's/^[Pp]olicy_profile:[[:space:]]*//')
    [ -z "$fm_policy_profile" ] && fm_policy_profile="standard"
    fm_max_total_attempts=$(echo "$frontmatter" | { grep -i '^max_total_attempts:' || true; } | sed 's/^[Mm]ax_total_attempts:[[:space:]]*//')
    fm_max_agents=$(echo "$frontmatter" | { grep -i '^max_agents:' || true; } | sed 's/^[Mm]ax_agents:[[:space:]]*//')
    fm_max_cost_usd=$(echo "$frontmatter" | { grep -i '^max_cost_usd:' || true; } | sed 's/^[Mm]ax_cost_usd:[[:space:]]*//')
    fm_max_elapsed_minutes=$(echo "$frontmatter" | { grep -i '^max_elapsed_minutes:' || true; } | sed 's/^[Mm]ax_elapsed_minutes:[[:space:]]*//')

    content=$(cat "$workflow_file")
    local current_step_num=""
    local current_step_name=""
    local current_block=""
    local in_steps=0
    local line

    while IFS= read -r line; do
        if echo "$line" | grep -Eq '^- \[[ xX]\] \*\*Step [0-9]+:'; then
            if [ -n "$current_step_num" ]; then
                _parse_step_block "$current_step_num" "$current_step_name" "$current_block"
            fi
            current_step_num=$(echo "$line" | sed -E 's/.*Step ([0-9]+):.*/\1/')
            current_step_name=$(echo "$line" | sed -E 's/.*Step [0-9]+:[[:space:]]*(.*)\*\*$/\1/')
            current_block=""
            in_steps=1
        elif echo "$line" | grep -Eq '^### [0-9]+\.'; then
            if [ -n "$current_step_num" ]; then
                _parse_step_block "$current_step_num" "$current_step_name" "$current_block"
            fi
            current_step_num=$(echo "$line" | sed -E 's/^### ([0-9]+)\..*/\1/')
            current_step_name=$(echo "$line" | sed -E 's/^### [0-9]+\.[[:space:]]*//')
            current_block=""
            in_steps=1
        elif [ "$in_steps" -eq 1 ]; then
            current_block="${current_block}${line}
"
        fi
    done <<< "$content"

    if [ -n "$current_step_num" ]; then
        _parse_step_block "$current_step_num" "$current_step_name" "$current_block"
    fi

    total_steps=${#step_numbers[@]}
    if [ "$total_steps" -eq 0 ]; then
        echo "ERROR: No steps found in workflow" >&2
        return 1
    fi
}

normalized_workflow_json() {
    local workflow="$1"
    local steps_json='[]'
    local i loop_json gate_json

    for i in "${!step_numbers[@]}"; do
        if [ "${step_loops[$i]}" = "false" ]; then
            loop_json=false
        else
            loop_json=$(jq -Rn --arg value "${step_loops[$i]}" '$value')
        fi
        gate_json=$(json_string_or_null "${step_gates[$i]/null/}")
        steps_json=$(jq -cn \
            --argjson existing "$steps_json" \
            --argjson number "${step_numbers[$i]}" \
            --arg name "${step_names[$i]}" \
            --arg action "${step_actions[$i]}" \
            --argjson loop "$loop_json" \
            --argjson max_iterations "${step_max_iters[$i]}" \
            --argjson verify "${step_verify_jsons[$i]}" \
            --argjson gate "$gate_json" '
            $existing + [{
                number: $number,
                name: $name,
                action: $action,
                loop: $loop,
                max_iterations: $max_iterations,
                verify: ($verify | del(.passed, .stdout, .stderr)),
                gate: $gate
            }]')
    done

    local max_total_attempts_json max_agents_json max_cost_json max_elapsed_json
    max_total_attempts_json=$(json_number_or_null "$fm_max_total_attempts")
    max_agents_json=$(json_number_or_null "$fm_max_agents")
    max_cost_json=$(json_number_or_null "$fm_max_cost_usd")
    max_elapsed_json=$(json_number_or_null "$fm_max_elapsed_minutes")

    jq -cn \
        --arg schema "hotl.workflow/v1" \
        --arg path "$workflow" \
        --arg slug "$workflow_slug" \
        --arg intent "$fm_intent" \
        --arg success "$fm_success" \
        --arg risk "$fm_risk" \
        --argjson auto_approve "$fm_auto" \
        --arg branch "$fm_branch" \
        --arg policy_profile "$fm_policy_profile" \
        --argjson max_total_attempts "$max_total_attempts_json" \
        --argjson max_agents "$max_agents_json" \
        --argjson max_cost_usd "$max_cost_json" \
        --argjson max_elapsed_minutes "$max_elapsed_json" \
        --argjson steps "$steps_json" '{
        schema: $schema,
        source: {format: "hotl-markdown", path: $path},
        workflow: {
            slug: $slug,
            intent: $intent,
            success_criteria: $success,
            risk_level: $risk,
            auto_approve: $auto_approve,
            branch: $branch,
            policy: {
                profile: $policy_profile,
                sensitive_actions: "human",
                budgets: {
                    max_total_attempts: $max_total_attempts,
                    max_agents: $max_agents,
                    max_cost_usd: $max_cost_usd,
                    max_elapsed_minutes: $max_elapsed_minutes
                }
            },
            total_steps: ($steps | length),
            steps: $steps
        }
    }'
}

cmd_normalize() {
    if [ $# -lt 1 ]; then
        echo "usage: hotl-rt normalize <workflow-file> [--json]" >&2
        exit 1
    fi
    require_jq
    local workflow="$1"
    shift
    if [ $# -gt 0 ] && { [ "$1" != "--json" ] || [ $# -gt 1 ]; }; then
        echo "ERROR: Unknown option for normalize: $1" >&2
        exit 1
    fi
    [ -f "$workflow" ] || { echo "ERROR: Workflow file not found: $workflow" >&2; exit 1; }

    workflow=$(abspath_existing "$workflow")
    local workflow_slug
    workflow_slug=$(slug_from_workflow "$workflow")
    local fm_intent fm_success fm_risk fm_auto fm_branch fm_policy_profile
    local fm_max_total_attempts fm_max_agents fm_max_cost_usd fm_max_elapsed_minutes total_steps
    local step_numbers=() step_names=() step_actions=() step_loops=()
    local step_max_iters=() step_verify_jsons=() step_gates=()
    parse_workflow_file "$workflow"
    normalized_workflow_json "$workflow"
}

cmd_init() {
    if [ $# -lt 1 ]; then
        echo "usage: hotl-rt init <workflow-file> [--require-owner] [--executor-mode <mode>] [--driver <id>] [--host <id>] [--repo-root <path>] [--execution-root <path>] [--source-workflow-path <path>] [--worktree-path <path>] [--branch <name>] [--source-branch <name>] [--source-head <sha>]" >&2
        exit 1
    fi

    local workflow="$1"
    shift
    local executor_mode="loop"
    local driver="generic"
    local host="fallback"
    local repo_root=""
    local execution_root=""
    local source_workflow_path=""
    local worktree_path=""
    local branch_override=""
    local source_branch=""
    local source_head=""
