#!/usr/bin/env bash
set -euo pipefail

# hotl-rt — HOTL shared runtime
# Owns state persistence, verification execution, and report generation.
# Agents call this; they don't replicate it.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HOTL_DIR=".hotl"
STATE_DIR="$HOTL_DIR/state"
REPORT_DIR="$HOTL_DIR/reports"
LOCK_DIR="$HOTL_DIR/locks"
ACTIVE_LOCK_PATH=""

# ── Dependency check ────────────────────────────────────────────────────────

require_jq() {
    if ! command -v jq &>/dev/null; then
        echo "ERROR: jq is required but not found." >&2
        echo "" >&2
        case "$(uname -s)" in
            Darwin*)
                echo "  Install on macOS:        brew install jq" >&2
                ;;
            Linux*)
                if command -v apt-get &>/dev/null; then
                    echo "  Install on Debian/Ubuntu: sudo apt-get install jq" >&2
                elif command -v dnf &>/dev/null; then
                    echo "  Install on Fedora/RHEL:   sudo dnf install jq" >&2
                else
                    echo "  Install on Linux:         https://jqlang.github.io/jq/download/" >&2
                fi
                ;;
            MINGW*|MSYS*|CYGWIN*)
                echo "  Install on Windows:" >&2
                echo "    scoop install jq" >&2
                echo "    choco install jq" >&2
                echo "    winget install jqlang.jq" >&2
                ;;
            *)
                echo "  Install jq: https://jqlang.github.io/jq/download/" >&2
                ;;
        esac
        echo "" >&2
        echo "  HOTL will fall back to inline execution without state persistence until jq is available." >&2
        exit 1
    fi
}

# ── Helpers ─────────────────────────────────────────────────────────────────

now_iso() {
    date -u +"%Y-%m-%dT%H:%M:%S+00:00"
}

now_time() {
    date -u +"%H:%M:%S"
}

random_hex() {
    local bytes="$1"
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex "$bytes"
        return
    fi
    if [ -r /dev/urandom ]; then
        od -An -N"$bytes" -tx1 /dev/urandom | tr -d ' \n'
        return
    fi
    return 1
}

generate_run_id() {
    local slug="$1"
    local ts nonce
    ts=$(date -u +"%Y%m%dT%H%M%SZ")
    nonce=$(random_hex 6) || {
        echo "ERROR: operating-system entropy is required for collision-resistant run ids" >&2
        return 1
    }
    echo "${slug}-${ts}-${nonce}"
}

slug_from_workflow() {
    local file="$1"
    local base
    base=$(basename "$file" .md)
    case "$base" in
        hotl-workflow-*)
            echo "${base#hotl-workflow-}"
            ;;
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*-workflow)
            echo "$base" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-(.*)-workflow$/\1/'
            ;;
        *-workflow)
            echo "${base%-workflow}"
            ;;
        *)
            echo "$base"
            ;;
    esac
}

ensure_dirs() {
    mkdir -p "$STATE_DIR" "$REPORT_DIR" "$LOCK_DIR"
}

validate_run_id() {
    local run_id="$1"
    if [ -z "$run_id" ] || [[ ! "$run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "ERROR: invalid run id: $run_id" >&2
        return 1
    fi
}

state_path_for_run_id() {
    local run_id="$1"
    validate_run_id "$run_id" || return 1
    printf '%s/%s.json\n' "$STATE_DIR" "$run_id"
}

release_active_lock() {
    if [ -n "$ACTIVE_LOCK_PATH" ] && [ -d "$ACTIVE_LOCK_PATH" ]; then
        rm -f "$ACTIVE_LOCK_PATH/pid" "$ACTIVE_LOCK_PATH/host"
        rmdir "$ACTIVE_LOCK_PATH" 2>/dev/null || true
    fi
    ACTIVE_LOCK_PATH=""
}

acquire_lock() {
    local lock_key="$1"
    local lock_path="$LOCK_DIR/${lock_key}.lock"
    local attempt owner_pid owner_host current_host

    ensure_dirs
    current_host=$(uname -n)
    if [ "$ACTIVE_LOCK_PATH" = "$lock_path" ]; then
        return 0
    fi
    if [ -n "$ACTIVE_LOCK_PATH" ]; then
        echo "ERROR: runtime cannot hold locks for two runs in one transition" >&2
        return 1
    fi

    for ((attempt = 1; attempt <= 200; attempt++)); do
        if mkdir "$lock_path" 2>/dev/null; then
            printf '%s\n' "$$" > "$lock_path/pid"
            printf '%s\n' "$current_host" > "$lock_path/host"
            ACTIVE_LOCK_PATH="$lock_path"
            trap release_active_lock EXIT
            trap 'exit 130' INT
            trap 'exit 143' TERM
            return 0
        fi

        owner_pid=""
        owner_host=""
        [ -f "$lock_path/pid" ] && owner_pid=$(sed -n '1p' "$lock_path/pid" 2>/dev/null || true)
        [ -f "$lock_path/host" ] && owner_host=$(sed -n '1p' "$lock_path/host" 2>/dev/null || true)
        if [ "$owner_host" = "$current_host" ] && [[ "$owner_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
            rm -f "$lock_path/pid" "$lock_path/host"
            rmdir "$lock_path" 2>/dev/null || true
            continue
        fi
        sleep 0.05
    done

    echo "ERROR: timed out waiting for HOTL writer lock: $lock_key" >&2
    return 1
}

acquire_run_lock() {
    local run_id="$1"
    validate_run_id "$run_id" || return 1
    acquire_lock "$run_id"
}

abspath_existing() {
    local path="$1"
    local dir
    dir=$(cd "$(dirname "$path")" && pwd -P)
    echo "${dir}/$(basename "$path")"
}

default_repo_root() {
    git rev-parse --show-toplevel 2>/dev/null || pwd -P
}

default_execution_root() {
    pwd -P
}

json_string_or_null() {
    local value="${1:-}"
    if [ -n "$value" ]; then
        jq -Rn --arg value "$value" '$value'
    else
        echo "null"
    fi
}

json_number_or_null() {
    local value="${1:-}"
    if [ -z "$value" ]; then
        echo null
    elif jq -en --arg value "$value" '$value | tonumber | select(. >= 0)' >/dev/null 2>&1; then
        jq -cn --arg value "$value" '$value | tonumber'
    else
        echo "ERROR: Expected a numeric workflow value, got: $value" >&2
        return 1
    fi
}

# Resolve a run-specific state file. With multiple runs present, callers must
# pass --run-id (or set HOTL_RUN_ID) rather than silently using the newest file.
find_active_state() {
    local requested_run_id="${1:-${HOTL_RUN_ID:-}}"
    if [ -n "$requested_run_id" ]; then
        local requested_state
        requested_state=$(state_path_for_run_id "$requested_run_id") || exit 1
        if [ ! -f "$requested_state" ]; then
            echo "ERROR: No HOTL run found for run_id: $requested_run_id" >&2
            exit 1
        fi
        echo "$requested_state"
        return
    fi

    local -a state_files=()
    shopt -s nullglob
    state_files=("$STATE_DIR"/*.json)
    shopt -u nullglob

    if [ "${#state_files[@]}" -eq 0 ]; then
        echo "ERROR: No active HOTL run found in $STATE_DIR/" >&2
        exit 1
    fi

    if [ "${#state_files[@]}" -gt 1 ]; then
        echo "ERROR: Multiple HOTL runs found in $STATE_DIR/. Select one with --run-id <run-id> or HOTL_RUN_ID." >&2
        for state_file in "${state_files[@]}"; do
            jq -r '"  - \(.run_id) [\(.status)] workflow=\(.workflow_path)"' "$state_file" >&2
        done
        exit 1
    fi

    echo "${state_files[0]}"
}

# Read a field from the active state JSON
state_get() {
    local file="$1"
    local path="$2"
    jq -r "$path" "$file"
}

# Update state JSON atomically (write to temp, then mv)
state_write() {
    local file="$1"
    local content="$2"
    local tmp
    tmp=$(mktemp "${file}.tmp.XXXXXX")
    content=$(jq '.revision = ((.revision // 0) + 1)' <<< "$content")
    printf '%s\n' "$content" > "$tmp"
    mv "$tmp" "$file"
}

# Get the report path from the state file
report_path_from_state() {
    local state_file="$1"
    state_get "$state_file" '.report_path'
}

# Update a line in the report matching a pattern
report_update_line() {
    local report="$1"
    local pattern="$2"
    local replacement="$3"
    local tmp
    tmp=$(mktemp "${report}.tmp.XXXXXX")
    sed "s|${pattern}|${replacement}|" "$report" > "$tmp"
    mv "$tmp" "$report"
}

# Append to the report event log
report_append_event() {
    local report="$1"
    local event="$2"
    echo "$event" >> "$report"
}

# Update the report summary table row for a step
report_update_step_row() {
    local report="$1"
    local step_num="$2"
    local new_status="$3"
    local new_iterations="$4"
    local tmp
    tmp=$(mktemp "${report}.tmp.XXXXXX")

    # Match the table row by step number at the start
    # Table format: |  N   | Name | Status | Iterations |
    awk -v num="$step_num" -v status="$new_status" -v iters="$new_iterations" '
    BEGIN { found=0 }
    {
        if (match($0, /^\|[[:space:]]*[0-9]+[[:space:]]*\|/)) {
            # Extract step number from this row
            split($0, parts, "|")
            gsub(/[[:space:]]/, "", parts[2])
            if (parts[2] == num) {
                # Rebuild the row preserving the name
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", parts[3])
                printf "| %2s   | %s | %s | %s |\n", num, parts[3], status, iters
                found=1
                next
            }
        }
        print
    }' "$report" > "$tmp"
    mv "$tmp" "$report"
}

report_write_finish_section() {
    local report="$1"
    local content="$2"
    local tmp
    tmp=$(mktemp "${report}.tmp.XXXXXX")

    awk '
    $0 == "## Finish Outcome" { exit }
    { print }
    ' "$report" > "$tmp"

    if [ -s "$tmp" ]; then
        printf '\n' >> "$tmp"
    fi

    {
        echo "## Finish Outcome"
        echo ""
        printf '%s\n' "$content"
    } >> "$tmp"

    mv "$tmp" "$report"
}

render_report_step_rows() {
    local state_file="$1"
    while IFS=$'\t' read -r number name status attempts gate_result gate_mode; do
        local rendered iterations
        if [ "$gate_result" = approved ]; then
            if [ "$gate_mode" = auto ]; then rendered='⚡ Auto-approved'; else rendered='✓ Approved'; fi
            iterations='-'
        elif [ "$gate_result" = rejected ]; then
            rendered='✗ Rejected'
            iterations='-'
        else
            case "$status" in
                pending) rendered='· Pending'; iterations='-' ;;
                in_progress) rendered='→ Running'; iterations="$attempts" ;;
                done) rendered='✓ Done'; iterations="$attempts" ;;
                failed) rendered='✗ Failed'; iterations="$attempts" ;;
                blocked) rendered='✗ Blocked'; iterations='-' ;;
                *) rendered="$status"; iterations="$attempts" ;;
            esac
        fi
        printf '| %2s   | %s | %s | %s |\n' "$number" "$name" "$rendered" "$iterations"
    done < <(jq -r '.steps[] | [.number,.name,.status,.attempts,(.gate_result // ""),(.gate_mode // "")] | @tsv' "$state_file")
}

report_matches_state() {
    local state_file="$1"
    local report="$2"
    local expected_row disposition

    [ -s "$report" ] || return 1
    grep -Fqx "# Execution Report: $(jq -r '.run_id' "$state_file")" "$report" || return 1
    grep -Fqx "**Updated:** $(jq -r '.last_update' "$state_file")" "$report" || return 1
    grep -Fqx "**Status:** $(jq -r '.status' "$state_file")" "$report" || return 1
    while IFS= read -r expected_row; do
        grep -Fqx -- "$expected_row" "$report" || return 1
    done < <(render_report_step_rows "$state_file")

    disposition=$(jq -r '.finish.disposition // empty' "$state_file")
    if [ -n "$disposition" ]; then
        grep -Fqx "**Disposition:** $disposition" "$report" || return 1
    fi
}

repair_report_from_state() {
    local state_file="$1"
    local report="$2"
    local tmp prior_events
    prior_events=""
    if [ -s "$report" ]; then
        prior_events=$(awk '
            $0 == "## Finish Outcome" { exit }
            capture { print }
            $0 == "## Event Log" { capture=1 }
        ' "$report")
    fi
    mkdir -p "$(dirname "$report")"
    tmp=$(mktemp "${report}.repair.XXXXXX")

    {
        printf '# Execution Report: %s\n\n' "$(jq -r '.run_id' "$state_file")"
        printf '**Workflow:** %s\n' "$(basename "$(jq -r '.workflow_path' "$state_file")")"
        printf '**Source Workflow:** %s\n' "$(jq -r '.source_workflow_path' "$state_file")"
        if [ "$(jq -r '.source_branch // empty' "$state_file")" != "" ]; then
            printf '**Source Branch:** %s\n' "$(jq -r '.source_branch' "$state_file")"
        fi
        if [ "$(jq -r '.source_head // empty' "$state_file")" != "" ]; then
            printf '**Source HEAD:** %s\n' "$(jq -r '.source_head' "$state_file")"
        fi
        printf '**Intent:** %s\n' "$(jq -r '.intent' "$state_file")"
        printf '**Branch:** %s\n' "$(jq -r '.branch' "$state_file")"
        printf '**Executor:** %s\n' "$(jq -r '.executor_mode' "$state_file")"
        printf '**Execution Root:** %s\n' "$(jq -r '.execution_root' "$state_file")"
        printf '**Started:** %s\n' "$(jq -r '.started_at' "$state_file")"
        printf '**Updated:** %s\n' "$(jq -r '.last_update' "$state_file")"
        printf '**Status:** %s\n\n' "$(jq -r '.status' "$state_file")"
        printf '| Step | Name | Status | Iterations |\n'
        printf '|------|------|--------|------------|\n'
        render_report_step_rows "$state_file"
        printf '\n## Event Log\n\n'
        if [ -n "$prior_events" ]; then
            printf '%s\n' "$prior_events"
        fi
        printf '**[%s]** Report repaired from authoritative state revision %s\n' "$(now_time)" "$(jq -r '.revision // 0' "$state_file")"
    } > "$tmp"
    mv "$tmp" "$report"

    local disposition
    disposition=$(jq -r '.finish.disposition // empty' "$state_file")
    if [ -n "$disposition" ]; then
        local finish_content
        finish_content=$(jq -r '
            ["**Disposition:** \(.finish.disposition)",
             "**Recorded:** \(.finish.recorded_at)",
             (if .finish.target_branch then "**Target Branch:** \(.finish.target_branch)" else empty end),
             (if .finish.remote then "**Remote:** \(.finish.remote)" else empty end),
             (if .finish.pr_url then "**PR URL:** \(.finish.pr_url)" else empty end),
             (if .finish.branch_action then "**Branch Action:** \(.finish.branch_action)" else empty end),
             (if .finish.worktree_action then "**Worktree Action:** \(.finish.worktree_action)" else empty end),
             (if .finish.artifacts_preserved_at then "**Artifacts Preserved At:** \(.finish.artifacts_preserved_at)" else empty end),
             (if .finish.notes then "**Notes:** \(.finish.notes)" else empty end)] | .[]
        ' "$state_file")
        report_write_finish_section "$report" "$finish_content"
    fi
}

ensure_report_from_state() {
    local state_file="$1"
    local report="$2"
    if ! report_matches_state "$state_file" "$report"; then
        repair_report_from_state "$state_file" "$report"
    fi
}

sha256_text() {
    if command -v shasum >/dev/null 2>&1; then
        printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
    else
        printf '%s' "$1" | sha256sum | awk '{print $1}'
    fi
}

new_owner_token() {
    random_hex 32 || {
        echo "ERROR: secure operating-system entropy is required for controller ownership tokens" >&2
        return 1
    }
}

enforce_controller_ownership() {
    local state_file="$1"
    local controller_status owner_token expected_hash now_epoch
    controller_status=$(jq -r '.controller.status // "legacy-unclaimed"' "$state_file")
    case "$controller_status" in
        legacy-unclaimed) return 0 ;;
        unclaimed|released)
            if [ "$(jq -r '.ownership_required // false' "$state_file")" = true ]; then
                echo "ERROR: This run requires an active controller; claim controller ownership first" >&2
                return 1
            fi
            return 0
            ;;
        active) ;;
        *) echo "ERROR: Run controller is '$controller_status'; claim or take over ownership first" >&2; return 1 ;;
    esac

    now_epoch=$(date -u +%s)
    if [ "$(jq -r '.controller.lease_expires_epoch // 0' "$state_file")" -le "$now_epoch" ]; then
        echo "ERROR: Controller lease expired; use owner takeover with a recorded reason" >&2
        return 1
    fi
    owner_token="${HOTL_OWNER_TOKEN:-}"
    [ -n "$owner_token" ] || {
        echo "ERROR: Active run requires the controller ownership token in HOTL_OWNER_TOKEN" >&2
        return 1
    }
    expected_hash=$(jq -r '.controller.token_sha256 // empty' "$state_file")
    [ "$(sha256_text "$owner_token")" = "$expected_hash" ] || {
        echo "ERROR: Invalid controller ownership token" >&2
        return 1
    }
}

enforce_execution_evidence_mutable() {
    local state_file="$1"
    local operation="$2"
    local status
    status=$(jq -r '.status' "$state_file")
    case "$status" in
        ready_to_finish|completed|abandoned)
            echo "ERROR: Run is '$status'; cannot mutate execution evidence with $operation" >&2
            return 1
            ;;
    esac
}

iso_to_epoch() {
    local value="$1"
    local normalized
    if date -u -d "$value" +%s >/dev/null 2>&1; then
        date -u -d "$value" +%s
        return
    fi
    normalized=$(printf '%s' "$value" | sed 's/+00:00$/+0000/')
    date -j -u -f '%Y-%m-%dT%H:%M:%S%z' "$normalized" +%s 2>/dev/null
}

elapsed_minutes_for_state() {
    local state_file="$1"
    local started_epoch now_epoch elapsed_seconds
    started_epoch=$(iso_to_epoch "$(jq -r '.started_at' "$state_file")") || return 1
    now_epoch=$(date -u +%s)
    elapsed_seconds=$((now_epoch - started_epoch))
    [ "$elapsed_seconds" -ge 0 ] || elapsed_seconds=0
    printf '%s\n' "$((elapsed_seconds / 60))"
}

enforce_transition_budgets() {
    local state_file="$1"
    local report="$2"
    local attempt_delta="${3:-0}"
    local elapsed evaluation exceeded updated ts

    elapsed=$(elapsed_minutes_for_state "$state_file") || {
        echo "ERROR: cannot evaluate elapsed runtime budget" >&2
        return 1
    }
    ts=$(now_iso)
    evaluation=$(jq --argjson attempt_delta "$attempt_delta" --argjson elapsed "$elapsed" '
        (.budgets.limits // {}) as $limits |
        (.budgets.observed // {}) as $observed |
        (([.steps[].attempts] | add // 0) + $attempt_delta) as $attempts |
        [{metric:"total_attempts",limit:($limits.total_attempts//null),observed:$attempts},
         {metric:"agents",limit:($limits.agents//null),observed:($observed.agents//null)},
         {metric:"cost_usd",limit:($limits.cost_usd//null),observed:($observed.cost_usd//null)},
         {metric:"elapsed_minutes",limit:($limits.elapsed_minutes//null),observed:$elapsed}]
        | map(. + {status:(if .limit==null then "unset" elif .observed==null then "unknown" elif .observed>.limit then "exceeded" else "within" end)})
    ' "$state_file")
    exceeded=$(jq '[.[] | select(.status=="exceeded") | .metric]' <<< "$evaluation")
    updated=$(jq --argjson exceeded "$exceeded" --argjson elapsed "$elapsed" --arg ts "$ts" '
        .budgets.observed.elapsed_minutes = $elapsed |
        .budgets.exceeded = $exceeded |
        .status = (if ($exceeded | length) > 0 then "paused" else .status end) |
        .last_update = $ts
    ' "$state_file")
    state_write "$state_file" "$updated"
    report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"

    if [ "$(jq 'length' <<< "$exceeded")" -gt 0 ]; then
        local names
        names=$(jq -r 'join(", ")' <<< "$exceeded")
        report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** paused"
        report_append_event "$report" "**[$(now_time)]** Runtime budget exceeded: $names"
        echo "ERROR: Runtime budget exceeded: $names" >&2
        return 1
    fi
}

build_summary_payload() {
    local state_file="$1"
    jq '{
        run_id: .run_id,
        workflow_path: .workflow_path,
        source_workflow_path: .source_workflow_path,
        source_branch: .source_branch,
        source_head: .source_head,
        workflow_slug: .workflow_slug,
        intent: .intent,
        branch: .branch,
        repo_root: .repo_root,
        execution_root: .execution_root,
        worktree_path: .worktree_path,
        executor_mode: .executor_mode,
        driver: (.driver // "generic"),
        host: (.host // "fallback"),
        status: .status,
        started_at: .started_at,
        last_update: .last_update,
        completed_at: .completed_at,
        total_steps: .total_steps,
        completed_steps: ([.steps[] | select(.status == "done")] | length),
        failed_steps: ([.steps[] | select(.status == "failed")] | length),
        blocked_steps: ([.steps[] | select(.status == "blocked")] | length),
        finish: (.finish // {
            disposition: null,
            recorded_at: null,
            target_branch: null,
            remote: null,
            pr_url: null,
            branch_action: null,
            worktree_action: null,
            artifacts_preserved_at: null,
            notes: null
        }),
        steps: [.steps[] | {
            number: .number,
            name: .name,
            status: .status,
            attempts: .attempts,
            verify_passed: .verify.passed,
            gate_result: .gate_result,
            gate_mode: .gate_mode,
            block_reason: .block_reason
        }]
    }' "$state_file"
}

verify_object_shell() {
    local cmd="$1"
    jq -cn --arg cmd "$cmd" '
        {
            type: "shell",
            command: $cmd,
            passed: null,
            stdout: null,
            stderr: null
        }
    '
}

verify_object_browser() {
    local url="$1"
    local check="$2"
    local ref="browser: ${url} - ${check}"
    jq -cn --arg ref "$ref" --arg url "$url" --arg check "$check" '
        {
            type: "browser",
            command: $ref,
            url: $url,
            check: $check,
            passed: null,
            stdout: null,
            stderr: null
        }
    '
}

verify_object_human_review() {
    local prompt="$1"
    jq -cn --arg prompt "$prompt" '
        {
            type: "human-review",
            command: null,
            prompt: $prompt,
            passed: null,
            stdout: null,
            stderr: null
        }
    '
}

verify_object_artifact() {
    local path="$1"
    local assert_kind="$2"
    local assert_value="$3"
    jq -cn --arg path "$path" --arg kind "$assert_kind" --arg value "$assert_value" '
        {
            type: "artifact",
            command: null,
            path: $path,
            assert: {
                kind: $kind,
                value: (if $value == "" then null else $value end)
            },
            passed: null,
            stdout: null,
            stderr: null
        }
    '
}

parse_verify_item_json() {
    local item_block="$1"
    local verify_type
    verify_type=$(echo "$item_block" | { grep -i 'type:' || true; } | sed 's/.*type:[[:space:]]*//' | tr -d ' ' | head -1)
    [ -z "$verify_type" ] && verify_type="shell"

    case "$verify_type" in
        shell)
            local cmd
            cmd=$(echo "$item_block" | { grep -i 'command:' || true; } | sed 's/.*command:[[:space:]]*//' | head -1)
            verify_object_shell "$cmd"
            ;;
        browser)
            local url check
            url=$(echo "$item_block" | { grep -i 'url:' || true; } | sed 's/.*url:[[:space:]]*//' | head -1)
            check=$(echo "$item_block" | { grep -i 'check:' || true; } | sed 's/.*check:[[:space:]]*//' | head -1)
            verify_object_browser "$url" "$check"
            ;;
        human-review)
            local prompt
            prompt=$(echo "$item_block" | { grep -i 'prompt:' || true; } | sed 's/.*prompt:[[:space:]]*//' | head -1)
            verify_object_human_review "$prompt"
            ;;
        artifact)
            local path assert_kind assert_value
            path=$(echo "$item_block" | { grep -i 'path:' || true; } | sed 's/.*path:[[:space:]]*//' | head -1)
            assert_kind=$(echo "$item_block" | { grep -i 'kind:' || true; } | sed 's/.*kind:[[:space:]]*//' | head -1)
            assert_value=$(echo "$item_block" | { grep -i 'value:' || true; } | sed 's/.*value:[[:space:]]*//' | head -1)
            assert_value=$(echo "$assert_value" | sed 's/^"//; s/"$//')
            verify_object_artifact "$path" "$assert_kind" "$assert_value"
            ;;
        *)
            jq -cn --arg type "$verify_type" '
                {
                    type: $type,
                    command: null,
                    passed: null,
                    stdout: null,
                    stderr: null
                }
            '
            ;;
    esac
}

parse_verify_block_json() {
    local block="$1"

    if echo "$block" | grep -Eq '^[[:space:]]*-[[:space:]]+'; then
        local checks_json="["
        local current_item=""
        local item_json=""
        local first=1

        while IFS= read -r vline; do
            if echo "$vline" | grep -Eq '^[[:space:]]*-[[:space:]]+'; then
                if [ -n "$current_item" ]; then
                    item_json=$(parse_verify_item_json "$current_item")
                    if [ "$first" -eq 1 ]; then
                        checks_json="${checks_json}${item_json}"
                        first=0
                    else
                        checks_json="${checks_json},${item_json}"
                    fi
                fi
                current_item=$(echo "$vline" | sed -E 's/^[[:space:]]*-[[:space:]]*//')
                current_item="${current_item}
"
            else
                current_item="${current_item}${vline}
"
            fi
        done <<< "$block"

        if [ -n "$current_item" ]; then
            item_json=$(parse_verify_item_json "$current_item")
            if [ "$first" -eq 1 ]; then
                checks_json="${checks_json}${item_json}"
            else
                checks_json="${checks_json},${item_json}"
            fi
        fi

        checks_json="${checks_json}]"
        jq -cn --argjson checks "$checks_json" '
            {
                type: "multi",
                command: null,
                checks: $checks,
                passed: null,
                stdout: null,
                stderr: null
            }
        '
        return
    fi

    parse_verify_item_json "$block"
}

VERIFY_STDOUT=""
VERIFY_STDERR=""
VERIFY_BLOCK_REASON=""

run_single_verify_check() {
    local check_json="$1"
    local verify_type
    verify_type=$(echo "$check_json" | jq -r '.type // "shell"')

    VERIFY_STDOUT=""
    VERIFY_STDERR=""
    VERIFY_BLOCK_REASON=""

    case "$verify_type" in
        shell)
            local verify_cmd
            verify_cmd=$(echo "$check_json" | jq -r '.command // ""')

            if [ -z "$verify_cmd" ]; then
                return 0
            fi

            local stdout_file stderr_file exit_code
            stdout_file=$(mktemp)
            stderr_file=$(mktemp)
            exit_code=0

            ( eval "$verify_cmd" ) >"$stdout_file" 2>"$stderr_file" || exit_code=$?

            VERIFY_STDOUT=$(cat "$stdout_file" | head -c 4096)
            VERIFY_STDERR=$(cat "$stderr_file" | head -c 4096)
            rm -f "$stdout_file" "$stderr_file"
            return "$exit_code"
            ;;
        browser)
            local url check
            url=$(echo "$check_json" | jq -r '.url // ""')
            check=$(echo "$check_json" | jq -r '.check // ""')

            if [ -z "$url" ] || [ "$url" = "null" ]; then
                VERIFY_BLOCK_REASON="browser verify missing url"
                return 200
            fi
            if [ -z "$check" ] || [ "$check" = "null" ]; then
                VERIFY_BLOCK_REASON="browser verify missing check"
                return 200
            fi

            VERIFY_BLOCK_REASON="human review required: browser verify requested for ${url} - ${check}"
            return 200
            ;;
        artifact)
            local path assert_kind assert_value
            path=$(echo "$check_json" | jq -r '.path // ""')
            assert_kind=$(echo "$check_json" | jq -r '.assert.kind // ""')
            assert_value=$(echo "$check_json" | jq -r '.assert.value // ""')

            if [ -z "$path" ]; then
                VERIFY_BLOCK_REASON="artifact verify missing path"
                return 200
            fi

            case "$assert_kind" in
                exists)
                    if [ -e "$path" ]; then
                        VERIFY_STDOUT="artifact exists: $path"
                        return 0
                    fi
                    VERIFY_STDERR="artifact missing: $path"
                    return 1
                    ;;
                contains)
                    if [ -z "$assert_value" ] || [ "$assert_value" = "null" ]; then
                        VERIFY_BLOCK_REASON="artifact assert kind contains requires value"
                        return 200
                    fi
                    if [ ! -f "$path" ]; then
                        VERIFY_STDERR="artifact missing: $path"
                        return 1
                    fi
                    if grep -Fq -- "$assert_value" "$path"; then
                        VERIFY_STDOUT="artifact contains expected text: $path"
                        return 0
                    fi
                    VERIFY_STDERR="artifact missing expected text in $path"
                    return 1
                    ;;
                matches-glob)
                    if [ -z "$assert_value" ] || [ "$assert_value" = "null" ]; then
                        VERIFY_BLOCK_REASON="artifact assert kind matches-glob requires value"
                        return 200
                    fi
                    case "$assert_value" in
                        */*)
                            VERIFY_BLOCK_REASON="artifact assert kind matches-glob expects a filename glob; put the directory in path"
                            return 200
                            ;;
                    esac
                    if [ ! -d "$path" ]; then
                        VERIFY_STDERR="artifact directory missing: $path"
                        return 1
                    fi
                    if find "$path" -maxdepth 1 -type f -name "$assert_value" | grep -q .; then
                        VERIFY_STDOUT="artifact matches glob: $path/$assert_value"
                        return 0
                    fi
                    VERIFY_STDERR="no artifact matches $assert_value in $path"
                    return 1
                    ;;
                *)
                    VERIFY_BLOCK_REASON="unsupported artifact assert kind: $assert_kind"
                    return 200
                    ;;
            esac
            ;;
        human-review)
            local prompt
            prompt=$(echo "$check_json" | jq -r '.prompt // ""')
            if [ -n "$prompt" ] && [ "$prompt" != "null" ]; then
                VERIFY_BLOCK_REASON="human review required: $prompt"
            else
                VERIFY_BLOCK_REASON="human review required"
            fi
            return 200
            ;;
        *)
            VERIFY_BLOCK_REASON="unsupported verify type: $verify_type"
            return 200
            ;;
    esac
}

run_verify_checks() {
    local verify_json="$1"
    local verify_type
    verify_type=$(echo "$verify_json" | jq -r '.type // "shell"')

    VERIFY_STDOUT=""
    VERIFY_STDERR=""
    VERIFY_BLOCK_REASON=""

    if [ "$verify_type" = "multi" ]; then
        local check_count
        check_count=$(echo "$verify_json" | jq '.checks | length')
        local idx

        for idx in $(seq 0 $((check_count - 1))); do
            local check_json
            check_json=$(echo "$verify_json" | jq -c ".checks[$idx]")
            run_single_verify_check "$check_json"
            local rc=$?

            if [ "$rc" -eq 200 ]; then
                return 200
            fi

            if [ -n "$VERIFY_STDOUT" ]; then
                if [ -n "${VERIFY_COMBINED_STDOUT:-}" ]; then
                    VERIFY_COMBINED_STDOUT="${VERIFY_COMBINED_STDOUT}
${VERIFY_STDOUT}"
                else
                    VERIFY_COMBINED_STDOUT="$VERIFY_STDOUT"
                fi
            fi

            if [ -n "$VERIFY_STDERR" ]; then
                if [ -n "${VERIFY_COMBINED_STDERR:-}" ]; then
                    VERIFY_COMBINED_STDERR="${VERIFY_COMBINED_STDERR}
${VERIFY_STDERR}"
                else
                    VERIFY_COMBINED_STDERR="$VERIFY_STDERR"
                fi
            fi

            if [ "$rc" -ne 0 ]; then
                VERIFY_STDOUT="${VERIFY_COMBINED_STDOUT:-}"
                VERIFY_STDERR="${VERIFY_COMBINED_STDERR:-}"
                return "$rc"
            fi
        done

        VERIFY_STDOUT="${VERIFY_COMBINED_STDOUT:-}"
        VERIFY_STDERR="${VERIFY_COMBINED_STDERR:-}"
        return 0
    fi

    run_single_verify_check "$verify_json"
}

