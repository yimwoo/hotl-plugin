#!/usr/bin/env bash
set -euo pipefail

# hotl-rt — HOTL shared runtime
# Owns state persistence, verification execution, and report generation.
# Agents call this; they don't replicate it.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HOTL_DIR=".hotl"
STATE_DIR="$HOTL_DIR/state"
REPORT_DIR="$HOTL_DIR/reports"

# ── Dependency check ────────────────────────────────────────────────────────

require_jq() {
    if ! command -v jq &>/dev/null; then
        echo "ERROR: jq is required but not found." >&2
        echo "" >&2
        case "$(uname -s)" in
            Darwin*)
                echo "  Install on macOS:        brew install jq" >&2
                ;;
            Linux*)
                if command -v apt-get &>/dev/null; then
                    echo "  Install on Debian/Ubuntu: sudo apt-get install jq" >&2
                elif command -v dnf &>/dev/null; then
                    echo "  Install on Fedora/RHEL:   sudo dnf install jq" >&2
                else
                    echo "  Install on Linux:         https://jqlang.github.io/jq/download/" >&2
                fi
                ;;
            MINGW*|MSYS*|CYGWIN*)
                echo "  Install on Windows:" >&2
                echo "    scoop install jq" >&2
                echo "    choco install jq" >&2
                echo "    winget install jqlang.jq" >&2
                ;;
            *)
                echo "  Install jq: https://jqlang.github.io/jq/download/" >&2
                ;;
        esac
        echo "" >&2
        echo "  HOTL will fall back to inline execution without state persistence until jq is available." >&2
        exit 1
    fi
}

# ── Helpers ─────────────────────────────────────────────────────────────────

now_iso() {
    date -u +"%Y-%m-%dT%H:%M:%S+00:00"
}

now_time() {
    date -u +"%H:%M:%S"
}

generate_run_id() {
    local slug="$1"
    local ts
    ts=$(date -u +"%Y%m%dT%H%M%SZ")
    echo "${slug}-${ts}"
}

slug_from_workflow() {
    local file="$1"
    local base
    base=$(basename "$file" .md)
    # Strip hotl-workflow- prefix
    echo "$base" | sed 's/^hotl-workflow-//'
}

ensure_dirs() {
    mkdir -p "$STATE_DIR" "$REPORT_DIR"
}

abspath_existing() {
    local path="$1"
    local dir
    dir=$(cd "$(dirname "$path")" && pwd -P)
    echo "${dir}/$(basename "$path")"
}

default_repo_root() {
    git rev-parse --show-toplevel 2>/dev/null || pwd -P
}

default_execution_root() {
    pwd -P
}

json_string_or_null() {
    local value="${1:-}"
    if [ -n "$value" ]; then
        jq -Rn --arg value "$value" '$value'
    else
        echo "null"
    fi
}

# Resolve a run-specific state file. With multiple runs present, callers must
# pass --run-id (or set HOTL_RUN_ID) rather than silently using the newest file.
find_active_state() {
    local requested_run_id="${1:-${HOTL_RUN_ID:-}}"
    if [ -n "$requested_run_id" ]; then
        local requested_state="${STATE_DIR}/${requested_run_id}.json"
        if [ ! -f "$requested_state" ]; then
            echo "ERROR: No HOTL run found for run_id: $requested_run_id" >&2
            exit 1
        fi
        echo "$requested_state"
        return
    fi

    local -a state_files=()
    shopt -s nullglob
    state_files=("$STATE_DIR"/*.json)
    shopt -u nullglob

    if [ "${#state_files[@]}" -eq 0 ]; then
        echo "ERROR: No active HOTL run found in $STATE_DIR/" >&2
        exit 1
    fi

    if [ "${#state_files[@]}" -gt 1 ]; then
        echo "ERROR: Multiple HOTL runs found in $STATE_DIR/. Select one with --run-id <run-id> or HOTL_RUN_ID." >&2
        for state_file in "${state_files[@]}"; do
            jq -r '"  - \(.run_id) [\(.status)] workflow=\(.workflow_path)"' "$state_file" >&2
        done
        exit 1
    fi

    echo "${state_files[0]}"
}

# Read a field from the active state JSON
state_get() {
    local file="$1"
    local path="$2"
    jq -r "$path" "$file"
}

# Update state JSON atomically (write to temp, then mv)
state_write() {
    local file="$1"
    local content="$2"
    local tmp="${file}.tmp"
    echo "$content" > "$tmp"
    mv "$tmp" "$file"
}

# Get the report path from the state file
report_path_from_state() {
    local state_file="$1"
    state_get "$state_file" '.report_path'
}

# Update a line in the report matching a pattern
report_update_line() {
    local report="$1"
    local pattern="$2"
    local replacement="$3"
    local tmp="${report}.tmp"
    sed "s|${pattern}|${replacement}|" "$report" > "$tmp"
    mv "$tmp" "$report"
}

# Append to the report event log
report_append_event() {
    local report="$1"
    local event="$2"
    echo "$event" >> "$report"
}

# Update the report summary table row for a step
report_update_step_row() {
    local report="$1"
    local step_num="$2"
    local new_status="$3"
    local new_iterations="$4"
    local tmp="${report}.tmp"

    # Match the table row by step number at the start
    # Table format: |  N   | Name | Status | Iterations |
    awk -v num="$step_num" -v status="$new_status" -v iters="$new_iterations" '
    BEGIN { found=0 }
    {
        if (match($0, /^\|[[:space:]]*[0-9]+[[:space:]]*\|/)) {
            # Extract step number from this row
            split($0, parts, "|")
            gsub(/[[:space:]]/, "", parts[2])
            if (parts[2] == num) {
                # Rebuild the row preserving the name
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", parts[3])
                printf "| %2s   | %s | %s | %s |\n", num, parts[3], status, iters
                found=1
                next
            }
        }
        print
    }' "$report" > "$tmp"
    mv "$tmp" "$report"
}

verify_object_shell() {
    local cmd="$1"
    jq -cn --arg cmd "$cmd" '
        {
            type: "shell",
            command: $cmd,
            passed: null,
            stdout: null,
            stderr: null
        }
    '
}

verify_object_browser() {
    local url="$1"
    local check="$2"
    local ref="browser: ${url} - ${check}"
    jq -cn --arg ref "$ref" --arg url "$url" --arg check "$check" '
        {
            type: "browser",
            command: $ref,
            url: $url,
            check: $check,
            passed: null,
            stdout: null,
            stderr: null
        }
    '
}

verify_object_human_review() {
    local prompt="$1"
    jq -cn --arg prompt "$prompt" '
        {
            type: "human-review",
            command: null,
            prompt: $prompt,
            passed: null,
            stdout: null,
            stderr: null
        }
    '
}

verify_object_artifact() {
    local path="$1"
    local assert_kind="$2"
    local assert_value="$3"
    jq -cn --arg path "$path" --arg kind "$assert_kind" --arg value "$assert_value" '
        {
            type: "artifact",
            command: null,
            path: $path,
            assert: {
                kind: $kind,
                value: (if $value == "" then null else $value end)
            },
            passed: null,
            stdout: null,
            stderr: null
        }
    '
}

parse_verify_item_json() {
    local item_block="$1"
    local verify_type
    verify_type=$(echo "$item_block" | { grep -i 'type:' || true; } | sed 's/.*type:[[:space:]]*//' | tr -d ' ' | head -1)
    [ -z "$verify_type" ] && verify_type="shell"

    case "$verify_type" in
        shell)
            local cmd
            cmd=$(echo "$item_block" | { grep -i 'command:' || true; } | sed 's/.*command:[[:space:]]*//' | head -1)
            verify_object_shell "$cmd"
            ;;
        browser)
            local url check
            url=$(echo "$item_block" | { grep -i 'url:' || true; } | sed 's/.*url:[[:space:]]*//' | head -1)
            check=$(echo "$item_block" | { grep -i 'check:' || true; } | sed 's/.*check:[[:space:]]*//' | head -1)
            verify_object_browser "$url" "$check"
            ;;
        human-review)
            local prompt
            prompt=$(echo "$item_block" | { grep -i 'prompt:' || true; } | sed 's/.*prompt:[[:space:]]*//' | head -1)
            verify_object_human_review "$prompt"
            ;;
        artifact)
            local path assert_kind assert_value
            path=$(echo "$item_block" | { grep -i 'path:' || true; } | sed 's/.*path:[[:space:]]*//' | head -1)
            assert_kind=$(echo "$item_block" | { grep -i 'kind:' || true; } | sed 's/.*kind:[[:space:]]*//' | head -1)
            assert_value=$(echo "$item_block" | { grep -i 'value:' || true; } | sed 's/.*value:[[:space:]]*//' | head -1)
            assert_value=$(echo "$assert_value" | sed 's/^"//; s/"$//')
            verify_object_artifact "$path" "$assert_kind" "$assert_value"
            ;;
        *)
            jq -cn --arg type "$verify_type" '
                {
                    type: $type,
                    command: null,
                    passed: null,
                    stdout: null,
                    stderr: null
                }
            '
            ;;
    esac
}

parse_verify_block_json() {
    local block="$1"

    if echo "$block" | grep -Eq '^[[:space:]]*-[[:space:]]+'; then
        local checks_json="["
        local current_item=""
        local item_json=""
        local first=1

        while IFS= read -r vline; do
            if echo "$vline" | grep -Eq '^[[:space:]]*-[[:space:]]+'; then
                if [ -n "$current_item" ]; then
                    item_json=$(parse_verify_item_json "$current_item")
                    if [ "$first" -eq 1 ]; then
                        checks_json="${checks_json}${item_json}"
                        first=0
                    else
                        checks_json="${checks_json},${item_json}"
                    fi
                fi
                current_item=$(echo "$vline" | sed -E 's/^[[:space:]]*-[[:space:]]*//')
                current_item="${current_item}
"
            else
                current_item="${current_item}${vline}
"
            fi
        done <<< "$block"

        if [ -n "$current_item" ]; then
            item_json=$(parse_verify_item_json "$current_item")
            if [ "$first" -eq 1 ]; then
                checks_json="${checks_json}${item_json}"
            else
                checks_json="${checks_json},${item_json}"
            fi
        fi

        checks_json="${checks_json}]"
        jq -cn --argjson checks "$checks_json" '
            {
                type: "multi",
                command: null,
                checks: $checks,
                passed: null,
                stdout: null,
                stderr: null
            }
        '
        return
    fi

    parse_verify_item_json "$block"
}

VERIFY_STDOUT=""
VERIFY_STDERR=""
VERIFY_BLOCK_REASON=""

run_single_verify_check() {
    local check_json="$1"
    local verify_type
    verify_type=$(echo "$check_json" | jq -r '.type // "shell"')

    VERIFY_STDOUT=""
    VERIFY_STDERR=""
    VERIFY_BLOCK_REASON=""

    case "$verify_type" in
        shell)
            local verify_cmd
            verify_cmd=$(echo "$check_json" | jq -r '.command // ""')

            if [ -z "$verify_cmd" ]; then
                return 0
            fi

            local stdout_file stderr_file exit_code
            stdout_file=$(mktemp)
            stderr_file=$(mktemp)
            exit_code=0

            eval "$verify_cmd" >"$stdout_file" 2>"$stderr_file" || exit_code=$?

            VERIFY_STDOUT=$(cat "$stdout_file" | head -c 4096)
            VERIFY_STDERR=$(cat "$stderr_file" | head -c 4096)
            rm -f "$stdout_file" "$stderr_file"
            return "$exit_code"
            ;;
        artifact)
            local path assert_kind assert_value
            path=$(echo "$check_json" | jq -r '.path // ""')
            assert_kind=$(echo "$check_json" | jq -r '.assert.kind // ""')
            assert_value=$(echo "$check_json" | jq -r '.assert.value // ""')

            if [ -z "$path" ]; then
                VERIFY_BLOCK_REASON="artifact verify missing path"
                return 200
            fi

            case "$assert_kind" in
                exists)
                    if [ -e "$path" ]; then
                        VERIFY_STDOUT="artifact exists: $path"
                        return 0
                    fi
                    VERIFY_STDERR="artifact missing: $path"
                    return 1
                    ;;
                contains)
                    if [ -z "$assert_value" ] || [ "$assert_value" = "null" ]; then
                        VERIFY_BLOCK_REASON="artifact assert kind contains requires value"
                        return 200
                    fi
                    if [ ! -f "$path" ]; then
                        VERIFY_STDERR="artifact missing: $path"
                        return 1
                    fi
                    if grep -Fq -- "$assert_value" "$path"; then
                        VERIFY_STDOUT="artifact contains expected text: $path"
                        return 0
                    fi
                    VERIFY_STDERR="artifact missing expected text in $path"
                    return 1
                    ;;
                matches-glob)
                    if [ -z "$assert_value" ] || [ "$assert_value" = "null" ]; then
                        VERIFY_BLOCK_REASON="artifact assert kind matches-glob requires value"
                        return 200
                    fi
                    case "$assert_value" in
                        */*)
                            VERIFY_BLOCK_REASON="artifact assert kind matches-glob expects a filename glob; put the directory in path"
                            return 200
                            ;;
                    esac
                    if [ ! -d "$path" ]; then
                        VERIFY_STDERR="artifact directory missing: $path"
                        return 1
                    fi
                    if find "$path" -maxdepth 1 -type f -name "$assert_value" | grep -q .; then
                        VERIFY_STDOUT="artifact matches glob: $path/$assert_value"
                        return 0
                    fi
                    VERIFY_STDERR="no artifact matches $assert_value in $path"
                    return 1
                    ;;
                *)
                    VERIFY_BLOCK_REASON="unsupported artifact assert kind: $assert_kind"
                    return 200
                    ;;
            esac
            ;;
        human-review)
            local prompt
            prompt=$(echo "$check_json" | jq -r '.prompt // ""')
            if [ -n "$prompt" ] && [ "$prompt" != "null" ]; then
                VERIFY_BLOCK_REASON="human review required: $prompt"
            else
                VERIFY_BLOCK_REASON="human review required"
            fi
            return 200
            ;;
        *)
            VERIFY_BLOCK_REASON="unsupported verify type: $verify_type"
            return 200
            ;;
    esac
}

run_verify_checks() {
    local verify_json="$1"
    local verify_type
    verify_type=$(echo "$verify_json" | jq -r '.type // "shell"')

    VERIFY_STDOUT=""
    VERIFY_STDERR=""
    VERIFY_BLOCK_REASON=""

    if [ "$verify_type" = "multi" ]; then
        local check_count
        check_count=$(echo "$verify_json" | jq '.checks | length')
        local idx

        for idx in $(seq 0 $((check_count - 1))); do
            local check_json
            check_json=$(echo "$verify_json" | jq -c ".checks[$idx]")
            run_single_verify_check "$check_json"
            local rc=$?

            if [ "$rc" -eq 200 ]; then
                return 200
            fi

            if [ -n "$VERIFY_STDOUT" ]; then
                if [ -n "${VERIFY_COMBINED_STDOUT:-}" ]; then
                    VERIFY_COMBINED_STDOUT="${VERIFY_COMBINED_STDOUT}
${VERIFY_STDOUT}"
                else
                    VERIFY_COMBINED_STDOUT="$VERIFY_STDOUT"
                fi
            fi

            if [ -n "$VERIFY_STDERR" ]; then
                if [ -n "${VERIFY_COMBINED_STDERR:-}" ]; then
                    VERIFY_COMBINED_STDERR="${VERIFY_COMBINED_STDERR}
${VERIFY_STDERR}"
                else
                    VERIFY_COMBINED_STDERR="$VERIFY_STDERR"
                fi
            fi

            if [ "$rc" -ne 0 ]; then
                VERIFY_STDOUT="${VERIFY_COMBINED_STDOUT:-}"
                VERIFY_STDERR="${VERIFY_COMBINED_STDERR:-}"
                return "$rc"
            fi
        done

        VERIFY_STDOUT="${VERIFY_COMBINED_STDOUT:-}"
        VERIFY_STDERR="${VERIFY_COMBINED_STDERR:-}"
        return 0
    fi

    run_single_verify_check "$verify_json"
}

# ── Subcommands ─────────────────────────────────────────────────────────────

cmd_init() {
    if [ $# -lt 1 ]; then
        echo "usage: hotl-rt init <workflow-file> [--executor-mode <mode>] [--repo-root <path>] [--execution-root <path>] [--source-workflow-path <path>] [--worktree-path <path>] [--branch <name>]" >&2
        exit 1
    fi

    local workflow="$1"
    shift
    local executor_mode="loop"
    local repo_root=""
    local execution_root=""
    local source_workflow_path=""
    local worktree_path=""
    local branch_override=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --executor-mode)
                executor_mode="$2"
                shift 2
                ;;
            --repo-root)
                repo_root="$2"
                shift 2
                ;;
            --execution-root)
                execution_root="$2"
                shift 2
                ;;
            --source-workflow-path)
                source_workflow_path="$2"
                shift 2
                ;;
            --worktree-path)
                worktree_path="$2"
                shift 2
                ;;
            --branch)
                branch_override="$2"
                shift 2
                ;;
            *)
                echo "ERROR: Unknown option for init: $1" >&2
                exit 1
                ;;
        esac
    done

    if [ ! -f "$workflow" ]; then
        echo "ERROR: Workflow file not found: $workflow" >&2
        exit 1
    fi

    require_jq
    ensure_dirs

    local slug
    slug=$(slug_from_workflow "$workflow")
    workflow=$(abspath_existing "$workflow")
    [ -z "$source_workflow_path" ] && source_workflow_path="$workflow"
    source_workflow_path=$(abspath_existing "$source_workflow_path")
    [ -z "$repo_root" ] && repo_root=$(default_repo_root)
    [ -z "$execution_root" ] && execution_root=$(default_execution_root)
    local run_id
    run_id=$(generate_run_id "$slug")
    local started_at
    started_at=$(now_iso)

    # Parse frontmatter
    local frontmatter
    frontmatter=$(sed -n '/^---$/,/^---$/p' "$workflow" | sed '1d;$d')

    local fm_intent fm_success fm_risk fm_auto fm_branch
    fm_intent=$(echo "$frontmatter" | { grep -i '^intent:' || true; } | sed 's/^[Ii]ntent:[[:space:]]*//')
    fm_success=$(echo "$frontmatter" | { grep -i '^success_criteria:' || true; } | sed 's/^[Ss]uccess_criteria:[[:space:]]*//')
    fm_risk=$(echo "$frontmatter" | { grep -i '^risk_level:' || true; } | sed 's/^[Rr]isk_level:[[:space:]]*//')
    [ -z "$fm_risk" ] && fm_risk="low"
    fm_auto=$(echo "$frontmatter" | { grep -i '^auto_approve:' || true; } | sed 's/^[Aa]uto_approve:[[:space:]]*//')
    [ -z "$fm_auto" ] && fm_auto="false"
    fm_branch=$(echo "$frontmatter" | { grep -i '^branch:' || true; } | sed 's/^[Bb]ranch:[[:space:]]*//')
    [ -z "$fm_branch" ] && fm_branch="hotl/${slug}"
    [ -n "$branch_override" ] && fm_branch="$branch_override"

    # Parse steps
    local content
    content=$(cat "$workflow")

    local step_numbers=()
    local step_names=()
    local step_actions=()
    local step_loops=()
    local step_max_iters=()
    local step_verify_jsons=()
    local step_gates=()

    local current_step_num=""
    local current_step_name=""
    local current_block=""
    local in_steps=0

    while IFS= read -r line; do
        # Detect step headers (checkbox or legacy)
        if echo "$line" | grep -Eq '^- \[[ xX]\] \*\*Step [0-9]+:'; then
            # Save previous step if any
            if [ -n "$current_step_num" ]; then
                _parse_step_block "$current_step_num" "$current_step_name" "$current_block"
            fi
            current_step_num=$(echo "$line" | sed -E 's/.*Step ([0-9]+):.*/\1/')
            current_step_name=$(echo "$line" | sed -E 's/.*Step [0-9]+:[[:space:]]*(.*)\*\*$/\1/')
            current_block=""
            in_steps=1
        elif echo "$line" | grep -Eq '^### [0-9]+\.'; then
            if [ -n "$current_step_num" ]; then
                _parse_step_block "$current_step_num" "$current_step_name" "$current_block"
            fi
            current_step_num=$(echo "$line" | sed -E 's/^### ([0-9]+)\..*/\1/')
            current_step_name=$(echo "$line" | sed -E 's/^### [0-9]+\.[[:space:]]*//')
            current_block=""
            in_steps=1
        elif [ "$in_steps" -eq 1 ]; then
            current_block="${current_block}${line}
"
        fi
    done <<< "$content"

    # Save last step
    if [ -n "$current_step_num" ]; then
        _parse_step_block "$current_step_num" "$current_step_name" "$current_block"
    fi

    local total_steps=${#step_numbers[@]}

    if [ "$total_steps" -eq 0 ]; then
        echo "ERROR: No steps found in workflow" >&2
        exit 1
    fi

    # Build state JSON
    local steps_json="["
    for i in "${!step_numbers[@]}"; do
        local verify_json="${step_verify_jsons[$i]}"
        local gate_val="${step_gates[$i]}"
        local max_iter="${step_max_iters[$i]}"

        # Escape strings for JSON
        local name_esc action_esc
        name_esc=$(echo "${step_names[$i]}" | sed 's/\\/\\\\/g; s/"/\\"/g')
        action_esc=$(echo "${step_actions[$i]}" | sed 's/\\/\\\\/g; s/"/\\"/g')

        [ "$i" -gt 0 ] && steps_json="${steps_json},"
        steps_json="${steps_json}
    {
      \"number\": ${step_numbers[$i]},
      \"name\": \"${name_esc}\",
      \"action\": \"${action_esc}\",
      \"status\": \"pending\",
      \"attempts\": 0,
      \"max_iterations\": ${max_iter},
      \"loop\": \"${step_loops[$i]}\",
      \"started_at\": null,
      \"completed_at\": null,
      \"verify\": ${verify_json},
      \"gate\": $([ "$gate_val" = "null" ] && echo "null" || echo "\"$gate_val\""),
      \"gate_result\": null,
      \"gate_mode\": null,
      \"block_reason\": null
    }"
    done
    steps_json="${steps_json}
  ]"

    local intent_esc success_esc
    intent_esc=$(echo "$fm_intent" | sed 's/\\/\\\\/g; s/"/\\"/g')
    success_esc=$(echo "$fm_success" | sed 's/\\/\\\\/g; s/"/\\"/g')

    local workflow_json source_workflow_json branch_json repo_root_json execution_root_json executor_mode_json report_path_json
    workflow_json=$(jq -Rn --arg value "$workflow" '$value')
    source_workflow_json=$(jq -Rn --arg value "$source_workflow_path" '$value')
    branch_json=$(jq -Rn --arg value "$fm_branch" '$value')
    repo_root_json=$(jq -Rn --arg value "$repo_root" '$value')
    execution_root_json=$(jq -Rn --arg value "$execution_root" '$value')
    executor_mode_json=$(jq -Rn --arg value "$executor_mode" '$value')
    report_path_json=$(jq -Rn --arg value "${execution_root}/${REPORT_DIR}/${run_id}.md" '$value')
    local worktree_json
    worktree_json=$(json_string_or_null "$worktree_path")
    local state_json="{
  \"run_id\": \"${run_id}\",
  \"workflow_path\": ${workflow_json},
  \"source_workflow_path\": ${source_workflow_json},
  \"workflow_slug\": \"${slug}\",
  \"intent\": \"${intent_esc}\",
  \"success_criteria\": \"${success_esc}\",
  \"risk_level\": \"${fm_risk}\",
  \"auto_approve\": ${fm_auto},
  \"branch\": ${branch_json},
  \"repo_root\": ${repo_root_json},
  \"execution_root\": ${execution_root_json},
  \"worktree_path\": ${worktree_json},
  \"executor_mode\": ${executor_mode_json},
  \"started_at\": \"${started_at}\",
  \"last_update\": \"${started_at}\",
  \"completed_at\": null,
  \"status\": \"running\",
  \"current_step\": 1,
  \"total_steps\": ${total_steps},
  \"report_path\": ${report_path_json},
  \"steps\": ${steps_json}
}"

    local state_file="${STATE_DIR}/${run_id}.json"
    echo "$state_json" > "$state_file"

    # Build report
    local report_file="${REPORT_DIR}/${run_id}.md"
    {
        echo "# Execution Report: ${run_id}"
        echo ""
        echo "**Workflow:** $(basename "$workflow")"
        echo "**Source Workflow:** ${source_workflow_path}"
        echo "**Intent:** ${fm_intent}"
        echo "**Branch:** ${fm_branch}"
        echo "**Executor:** ${executor_mode}"
        echo "**Execution Root:** ${execution_root}"
        if [ -n "$worktree_path" ]; then
            echo "**Worktree:** ${worktree_path}"
        fi
        echo "**Started:** ${started_at}"
        echo "**Updated:** ${started_at}"
        echo "**Status:** running"
        echo ""
        echo "| Step | Name | Status | Iterations |"
        echo "|------|------|--------|------------|"
        for i in "${!step_numbers[@]}"; do
            printf "| %2s   | %s | · Pending | - |\n" "${step_numbers[$i]}" "${step_names[$i]}"
        done
        echo ""
        echo "## Event Log"
        echo ""
    } > "$report_file"

    # Print run_id to stdout
    echo "$run_id"
}

# Parse a step block and append to arrays
_parse_step_block() {
    local num="$1"
    local name="$2"
    local block="$3"

    local action="" loop_val="false" max_iter="3" gate_val="null"
    local verify_json
    verify_json=$(verify_object_shell "")

    action=$(echo "$block" | { grep -i '^action:' || true; } | sed 's/^[Aa]ction:[[:space:]]*//' | head -1)
    loop_val=$(echo "$block" | { grep -i '^loop:' || true; } | sed 's/^[Ll]oop:[[:space:]]*//' | head -1)
    [ -z "$loop_val" ] && loop_val="false"

    local mi
    mi=$(echo "$block" | { grep -i '^max_iterations:' || true; } | sed 's/^[Mm]ax_iterations:[[:space:]]*//' | head -1)
    [ -n "$mi" ] && max_iter="$mi"

    # Parse verify (scalar form only for v1 shell support)
    local verify_line
    verify_line=$(echo "$block" | { grep -i '^verify:' || true; } | head -1)
    if [ -n "$verify_line" ]; then
        local vval
        vval=$(echo "$verify_line" | sed 's/^[Vv]erify:[[:space:]]*//')
        if [ -n "$vval" ]; then
            # Scalar form — type: shell
            verify_json=$(verify_object_shell "$vval")
        else
            local struct_block=""
            local in_verify=0
            while IFS= read -r vline; do
                if [ "$in_verify" -eq 0 ] && echo "$vline" | grep -qi '^verify:$'; then
                    in_verify=1
                    continue
                fi
                if [ "$in_verify" -eq 1 ]; then
                    if echo "$vline" | grep -Eq '^[[:space:]]'; then
                        struct_block="${struct_block}${vline}
"
                    elif [ -z "$vline" ]; then
                        continue
                    else
                        break
                    fi
                fi
            done <<< "$block"

            if [ -n "$struct_block" ]; then
                verify_json=$(parse_verify_block_json "$struct_block")
            fi
        fi
    fi

    local gv
    gv=$(echo "$block" | { grep -i '^gate:' || true; } | sed 's/^[Gg]ate:[[:space:]]*//' | head -1)
    [ -n "$gv" ] && gate_val="$gv"

    step_numbers+=("$num")
    step_names+=("$name")
    step_actions+=("$action")
    step_loops+=("$loop_val")
    step_max_iters+=("$max_iter")
    step_verify_jsons+=("$verify_json")
    step_gates+=("$gate_val")
}

cmd_step() {
    if [ $# -lt 2 ]; then
        echo "usage: hotl-rt step <step-number> <start|verify|retry|block> [--run-id <run-id>]" >&2
        exit 1
    fi

    require_jq

    local step_num="$1"
    local action="$2"
    shift 2
    local run_id="${HOTL_RUN_ID:-}"

    case "$action" in
        start|verify|retry)
            if [ $# -gt 0 ]; then
                if [ "$1" = "--run-id" ] && [ $# -eq 2 ]; then
                    run_id="$2"
                    shift 2
                else
                    echo "ERROR: Unknown option for step $action: $1" >&2
                    exit 1
                fi
            fi
            ;;
    esac

    local state_file
    state_file=$(find_active_state "$run_id")
    local report
    report=$(report_path_from_state "$state_file")
    local ts
    ts=$(now_iso)
    local time_short
    time_short=$(now_time)

    case "$action" in
        start)
            # Validate step exists and is pending or failed (for retry-then-start)
            local current_status
            current_status=$(jq -r ".steps[$((step_num - 1))].status" "$state_file")
            if [ "$current_status" != "pending" ] && [ "$current_status" != "in_progress" ]; then
                echo "ERROR: Step $step_num is '$current_status', expected 'pending'" >&2
                exit 1
            fi

            local step_name
            step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")

            # Update state JSON
            local updated
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" '
                .status = "running" |
                .current_step = $num |
                .last_update = $ts |
                .steps[$num - 1].status = "in_progress" |
                .steps[$num - 1].started_at = $ts |
                .steps[$num - 1].attempts += 1
            ' "$state_file")
            state_write "$state_file" "$updated"

            # Update report
            local attempts
            attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
            report_update_step_row "$report" "$step_num" "→ Running" "$attempts"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$time_short]** → Step $step_num: $step_name"

            echo "started step $step_num"
            ;;

        verify)
            local verify_type verify_cmd step_name verify_json
            verify_type=$(jq -r ".steps[$((step_num - 1))].verify.type" "$state_file")
            verify_cmd=$(jq -r ".steps[$((step_num - 1))].verify.command" "$state_file")
            verify_json=$(jq -c ".steps[$((step_num - 1))].verify" "$state_file")
            step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")

            # No verify configuration — auto-pass
            if [ -z "$verify_json" ] || [ "$verify_json" = "null" ]; then
                # Block with unsupported type
                local updated
                updated=$(jq --arg ts "$ts" --argjson num "$step_num" '
                    .last_update = $ts |
                    .steps[$num - 1].status = "done" |
                    .steps[$num - 1].completed_at = $ts |
                    .steps[$num - 1].verify.passed = true
                ' "$state_file")
                state_write "$state_file" "$updated"

                local attempts
                attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
                report_update_step_row "$report" "$step_num" "✓ Done" "$attempts"
                report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
                report_append_event "$report" "**[$time_short]** ✓ Step $step_num: Done (no verify, $attempts attempt(s))"

                echo "pass (no verify command)"
                exit 0
            fi

            if [ -z "$verify_cmd" ] || [ "$verify_cmd" = "null" ]; then
                if [ "$verify_type" = "shell" ]; then
                    # No verify command — auto-pass
                    local updated
                    updated=$(jq --arg ts "$ts" --argjson num "$step_num" '
                        .last_update = $ts |
                        .steps[$num - 1].status = "done" |
                        .steps[$num - 1].completed_at = $ts |
                        .steps[$num - 1].verify.passed = true
                    ' "$state_file")
                    state_write "$state_file" "$updated"

                    local attempts
                    attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
                    report_update_step_row "$report" "$step_num" "✓ Done" "$attempts"
                    report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
                    report_append_event "$report" "**[$time_short]** ✓ Step $step_num: Done (no verify, $attempts attempt(s))"

                    echo "pass (no verify command)"
                    exit 0
                fi
            fi

            VERIFY_COMBINED_STDOUT=""
            VERIFY_COMBINED_STDERR=""
            set +e
            run_verify_checks "$verify_json"
            local exit_code=$?
            set -e

            if [ "$exit_code" -eq 200 ]; then
                local run_status
                run_status="blocked"
                if printf '%s' "$VERIFY_BLOCK_REASON" | grep -q '^human review required'; then
                    run_status="paused"
                fi

                local updated
                updated=$(jq --arg ts "$ts" --arg reason "$VERIFY_BLOCK_REASON" --arg status "$run_status" --argjson num "$step_num" '
                    .status = $status |
                    .last_update = $ts |
                    .steps[$num - 1].status = "blocked" |
                    .steps[$num - 1].block_reason = $reason
                ' "$state_file")
                state_write "$state_file" "$updated"

                report_update_step_row "$report" "$step_num" "✗ Blocked" "-"
                report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $run_status"
                report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
                report_append_event "$report" "**[$time_short]** ✗ Step $step_num: Blocked ($VERIFY_BLOCK_REASON)"

                echo "blocked: $VERIFY_BLOCK_REASON"
                exit 1
            fi

            local stdout_content stderr_content
            stdout_content="${VERIFY_STDOUT:-}"
            stderr_content="${VERIFY_STDERR:-}"

            # Escape for JSON
            local stdout_esc stderr_esc
            stdout_esc=$(echo "$stdout_content" | jq -Rs '.')
            stderr_esc=$(echo "$stderr_content" | jq -Rs '.')

            if [ "$exit_code" -eq 0 ]; then
                # PASS — transition to done
                local updated
                updated=$(jq --arg ts "$ts" --argjson num "$step_num" \
                    --argjson stdout "$stdout_esc" --argjson stderr "$stderr_esc" '
                    .last_update = $ts |
                    .steps[$num - 1].status = "done" |
                    .steps[$num - 1].completed_at = $ts |
                    .steps[$num - 1].verify.passed = true |
                    .steps[$num - 1].verify.stdout = $stdout |
                    .steps[$num - 1].verify.stderr = $stderr
                ' "$state_file")
                state_write "$state_file" "$updated"

                local attempts
                attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
                report_update_step_row "$report" "$step_num" "✓ Done" "$attempts"
                report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
                report_append_event "$report" "**[$time_short]** ✓ Step $step_num: Done ($attempts attempt(s))"

                echo "pass"
                exit 0
            fi

            # FAIL — transition to failed
            local updated
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" \
                --argjson stdout "$stdout_esc" --argjson stderr "$stderr_esc" '
                .last_update = $ts |
                .steps[$num - 1].status = "failed" |
                .steps[$num - 1].verify.passed = false |
                .steps[$num - 1].verify.stdout = $stdout |
                .steps[$num - 1].verify.stderr = $stderr
            ' "$state_file")
            state_write "$state_file" "$updated"

            local attempts
            attempts=$(echo "$updated" | jq -r ".steps[$((step_num - 1))].attempts")
            report_update_step_row "$report" "$step_num" "✗ Failed" "$attempts"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$time_short]** ✗ Step $step_num: Failed ($attempts attempt(s))"
            if [ -n "$stderr_content" ]; then
                report_append_event "$report" "  verify stderr: $stderr_content"
            fi
            if [ -n "$stdout_content" ]; then
                report_append_event "$report" "  verify stdout: $stdout_content"
            fi

            echo "fail"
            exit 1
            ;;

        retry)
            local current_status
            current_status=$(jq -r ".steps[$((step_num - 1))].status" "$state_file")
            if [ "$current_status" != "failed" ]; then
                echo "ERROR: Step $step_num is '$current_status', expected 'failed' for retry" >&2
                exit 1
            fi

            local step_name attempts
            step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")
            attempts=$(jq -r ".steps[$((step_num - 1))].attempts" "$state_file")
            local max_iter
            max_iter=$(jq -r ".steps[$((step_num - 1))].max_iterations" "$state_file")

            local updated
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" '
                .last_update = $ts |
                .steps[$num - 1].status = "in_progress" |
                .steps[$num - 1].verify.passed = null |
                .steps[$num - 1].verify.stdout = null |
                .steps[$num - 1].verify.stderr = null
            ' "$state_file")
            state_write "$state_file" "$updated"

            local new_attempt=$((attempts + 1))
            report_update_step_row "$report" "$step_num" "↻ Retrying" "$new_attempt"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$time_short]** ↻ Step $step_num: Retrying ($new_attempt/$max_iter)"

            echo "retrying step $step_num (attempt $new_attempt/$max_iter)"
            ;;

        block)
            local reason=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --reason) reason="$2"; shift 2 ;;
                    --run-id) run_id="$2"; shift 2 ;;
                    *) echo "ERROR: Unknown option for block: $1" >&2; exit 1 ;;
                esac
            done

            if [ -z "$reason" ]; then
                echo "ERROR: --reason is required for block" >&2
                exit 1
            fi

            state_file=$(find_active_state "$run_id")
            report=$(report_path_from_state "$state_file")

            local step_name
            step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")

            local updated
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" --arg reason "$reason" '
                .status = "blocked" |
                .last_update = $ts |
                .steps[$num - 1].status = "blocked" |
                .steps[$num - 1].block_reason = $reason
            ' "$state_file")
            state_write "$state_file" "$updated"

            report_update_step_row "$report" "$step_num" "✗ Blocked" "-"
            report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** blocked"
            report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
            report_append_event "$report" "**[$time_short]** ✗ Step $step_num: Blocked — $reason"

            echo "blocked step $step_num: $reason"
            ;;

        *)
            echo "ERROR: Unknown step action: $action" >&2
            echo "usage: hotl-rt step <step-number> <start|verify|retry|block> [--run-id <run-id>]" >&2
            exit 1
            ;;
    esac
}

cmd_gate() {
    if [ $# -lt 2 ]; then
        echo "usage: hotl-rt gate <step-number> <approved|rejected> [--mode auto|human] [--run-id <run-id>]" >&2
        exit 1
    fi

    require_jq

    local step_num="$1"
    local decision="$2"
    shift 2
    local gate_mode="human"
    local run_id="${HOTL_RUN_ID:-}"

    while [ $# -gt 0 ]; do
        case "$1" in
            --mode)
                gate_mode="$2"
                shift 2
                ;;
            --run-id)
                run_id="$2"
                shift 2
                ;;
            *)
                echo "ERROR: Unknown option for gate: $1" >&2
                exit 1
                ;;
        esac
    done

    if [ "$decision" != "approved" ] && [ "$decision" != "rejected" ]; then
        echo "ERROR: Gate decision must be 'approved' or 'rejected', got: $decision" >&2
        exit 1
    fi

    if [ "$gate_mode" != "auto" ] && [ "$gate_mode" != "human" ]; then
        echo "ERROR: Gate mode must be 'auto' or 'human', got: $gate_mode" >&2
        exit 1
    fi

    local state_file
    state_file=$(find_active_state "$run_id")
    local report
    report=$(report_path_from_state "$state_file")
    local ts
    ts=$(now_iso)
    local time_short
    time_short=$(now_time)

    local step_name
    step_name=$(jq -r ".steps[$((step_num - 1))].name" "$state_file")
    local current_status
    current_status=$(jq -r ".steps[$((step_num - 1))].status" "$state_file")
    local block_reason
    block_reason=$(jq -r ".steps[$((step_num - 1))].block_reason // \"\"" "$state_file")

    if [ "$current_status" = "blocked" ] && printf '%s' "$block_reason" | grep -q '^human review required'; then
        local updated review_note status_text

        if [ "$decision" = "approved" ]; then
            review_note="human review approved"
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" --arg decision "$decision" --arg gate_mode "$gate_mode" --arg note "$review_note" '
                .status = "running" |
                .last_update = $ts |
                .steps[$num - 1].status = "done" |
                .steps[$num - 1].completed_at = $ts |
                .steps[$num - 1].block_reason = null |
                .steps[$num - 1].gate_result = $decision |
                .steps[$num - 1].gate_mode = $gate_mode |
                .steps[$num - 1].verify.passed = true |
                .steps[$num - 1].verify.stdout = $note |
                .steps[$num - 1].verify.stderr = null
            ' "$state_file")
            status_text="✓ Approved"
        else
            review_note="human review rejected"
            updated=$(jq --arg ts "$ts" --argjson num "$step_num" --arg decision "$decision" --arg gate_mode "$gate_mode" --arg reason "$review_note" '
                .status = "blocked" |
                .last_update = $ts |
                .steps[$num - 1].status = "blocked" |
                .steps[$num - 1].block_reason = $reason |
                .steps[$num - 1].gate_result = $decision |
                .steps[$num - 1].gate_mode = $gate_mode |
                .steps[$num - 1].verify.passed = false |
                .steps[$num - 1].verify.stdout = null |
                .steps[$num - 1].verify.stderr = $reason
            ' "$state_file")
            status_text="✗ Rejected"
        fi

        state_write "$state_file" "$updated"
        report_update_step_row "$report" "$step_num" "$status_text" "-"
        if [ "$decision" = "approved" ]; then
            report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** running"
        else
            report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** blocked"
        fi
        report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
        report_append_event "$report" "**[$time_short]** Human review for Step $step_num: $decision (${gate_mode})"

        echo "human-review $step_num: $decision (${gate_mode})"
        return
    fi

    local updated
    updated=$(jq --arg ts "$ts" --argjson num "$step_num" --arg decision "$decision" --arg gate_mode "$gate_mode" '
        .status = (if .status == "paused" and $decision == "approved" then "running" elif $decision == "rejected" then "blocked" else .status end) |
        .last_update = $ts |
        .steps[$num - 1].gate_result = $decision |
        .steps[$num - 1].gate_mode = $gate_mode
    ' "$state_file")
    state_write "$state_file" "$updated"

    local status_text
    if [ "$decision" = "approved" ]; then
        if [ "$gate_mode" = "auto" ]; then
            status_text="⚡ Auto-approved"
        else
            status_text="✓ Approved"
        fi
    else
        status_text="✗ Rejected"
    fi

    report_update_step_row "$report" "$step_num" "$status_text" "-"
    if [ "$decision" = "approved" ]; then
        report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** running"
    else
        report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** blocked"
    fi
    report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
    report_append_event "$report" "**[$time_short]** Gate Step $step_num: $decision (${gate_mode})"

    echo "gate $step_num: $decision (${gate_mode})"
}

cmd_finalize() {
    require_jq
    local run_id="${HOTL_RUN_ID:-}"

    while [ $# -gt 0 ]; do
        case "$1" in
            --json)
                shift
                ;;
            --run-id)
                run_id="$2"
                shift 2
                ;;
            *)
                echo "ERROR: Unknown option for finalize: $1" >&2
                exit 1
                ;;
        esac
    done

    local state_file
    state_file=$(find_active_state "$run_id")
    local report
    report=$(report_path_from_state "$state_file")
    local ts
    ts=$(now_iso)
    local time_short
    time_short=$(now_time)

    # Determine final status
    local has_failed has_blocked
    has_failed=$(jq '[.steps[] | select(.status == "failed")] | length' "$state_file")
    has_blocked=$(jq '[.steps[] | select(.status == "blocked")] | length' "$state_file")

    local final_status="completed"
    if [ "$has_failed" -gt 0 ] || [ "$has_blocked" -gt 0 ]; then
        final_status="blocked"
    fi

    local updated
    updated=$(jq --arg ts "$ts" --arg status "$final_status" '
        .status = $status |
        .completed_at = $ts |
        .last_update = $ts
    ' "$state_file")
    state_write "$state_file" "$updated"

    # Update report
    report_update_line "$report" "^\*\*Status:\*\*.*" "**Status:** $final_status"
    report_update_line "$report" "^\*\*Updated:\*\*.*" "**Updated:** $ts"
    report_append_event "$report" "**[$time_short]** Run finalized: $final_status"

    # Build summary payload
    local summary
    summary=$(jq '{
        run_id: .run_id,
        workflow_path: .workflow_path,
        source_workflow_path: .source_workflow_path,
        workflow_slug: .workflow_slug,
        intent: .intent,
        branch: .branch,
        repo_root: .repo_root,
        execution_root: .execution_root,
        worktree_path: .worktree_path,
        executor_mode: .executor_mode,
        status: .status,
        started_at: .started_at,
        last_update: .last_update,
        completed_at: .completed_at,
        total_steps: .total_steps,
        completed_steps: ([.steps[] | select(.status == "done")] | length),
        failed_steps: ([.steps[] | select(.status == "failed")] | length),
        blocked_steps: ([.steps[] | select(.status == "blocked")] | length),
        steps: [.steps[] | {
            number: .number,
            name: .name,
            status: .status,
            attempts: .attempts,
            verify_passed: .verify.passed,
            gate_result: .gate_result,
            gate_mode: .gate_mode,
            block_reason: .block_reason
        }]
    }' "$state_file")

    echo "$summary"
}

cmd_summary() {
    if [ $# -lt 1 ]; then
        echo "usage: hotl-rt summary <run-id> [--json]" >&2
        exit 1
    fi

    require_jq

    local run_id="$1"
